// The `core` package root.
//
// `core` is the small set of always-available declarations the compiler wires
// built-in syntax to (`#lang` items) plus the prelude types every program can
// name unqualified (`Option`, `Result`, ...). It is an **ordinary package**: a
// directory of `.nest` files with this one as its root, loaded from disk like any
// other. Nothing about it is baked into the compiler — the compiler finds what it
// needs by `#lang` tag, never by name or by path, so swapping this package out
// swaps the language's operators and control flow with it.
//
// This file only re-exports, and it re-exports **namespaces**, not members: the
// root of `core` is a table of contents, so `import <core/ops>` names the `ops`
// namespace below and `<core/cmp>` names `cmp`. Only `prelude` is globbed into
// every file, and only because it carries the `#lang("prelude")` tag the
// compiler looks for (§4.6).
//
// Signatures are illustrative in places — there is no codegen yet.

@public
#lang("prelude")
prelude :: import "prelude.nest"

@public ops     :: import "ops.nest"
@public cmp     :: import "cmp.nest"
@public default :: import "default.nest"
@public control :: import "control.nest"
@public option  :: import "option.nest"
@public result  :: import "result.nest"
@public iter    :: import "iter.nest"
@public range   :: import "range.nest"
@public slice   :: import "slice.nest"
@public loc     :: import "loc.nest"
@public mem     :: import "mem.nest"
@public fail    :: import "fail.nest"
@public gc      :: import "gc.nest"

// `str.nest` gets no namespace re-export: its one public member is `str`, which
// the prelude already exports, and a `str` namespace sitting beside the `str`
// type would read as the same name meaning two things.
