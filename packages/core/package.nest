// The `core` package root.
//
// `core` is the small set of always-available declarations the compiler wires
// built-in syntax to (`#lang` items) plus the prelude types every program can
// name unqualified (`Option`, `Result`, ...). It is an **ordinary package**: a
// directory of `.nest` files with this one as its root, loaded from disk like any
// other. Nothing about it is baked into the compiler — the compiler finds what it
// needs by `#lang` tag, never by name or by path, so swapping this package out
// swaps the language's operators and control flow with it.
//
// This file only re-exports, and it re-exports **namespaces**, not members: the
// root of `core` is a table of contents, so `import <core/ops>` names the `ops`
// namespace below and `<core/cmp>` names `cmp`. Only `prelude` is globbed into
// every file, and only because it carries the `#lang("prelude")` tag the
// compiler looks for (§4.6).
//
// Signatures are illustrative in places — there is no codegen yet.

@public
#lang("prelude")
prelude :: import "prelude.nest"

// The files are grouped in folders — `types/`, `iter/`, `fmt/`, `mem/`, `rt/` —
// and the namespaces are not: a program writes `<core/option>`, not
// `<core/types/option>`. The folders are how `core` is kept; this list is how
// it is used.

// Operators, comparison, defaults.
@public ops     :: import "ops.nest"
@public cmp     :: import "cmp.nest"
@public default :: import "default.nest"

// The types `.?` and friends are made of, and the integer aliases.
@public control :: import "types/control.nest"
@public option  :: import "types/option.nest"
@public result  :: import "types/result.nest"
@public num     :: import "types/num.nest"

// Sequences: iteration, ranges, slices.
@public iter    :: import "iter/iter.nest"
@public range   :: import "iter/range.nest"
@public slice   :: import "iter/slice.nest"

// Memory: allocation, the collector, C's types.
@public mem     :: import "mem/mem.nest"
@public gc      :: import "mem/gc.nest"
@public c       :: import "mem/c.nest"

// Formatting.
@public fmt     :: import "fmt/fmt.nest"

// The run time: panics and where they happened.
@public fail    :: import "rt/fail.nest"
@public loc     :: import "rt/loc.nest"

// The build: the generated `target.nest` and the enums it is written in.
@public os      :: import "os.nest"
@public target  :: import "target.nest"

@public reflect :: import "reflect.nest"

// `rt/test.nest` is imported and **not** re-exported: it is how `nestc --test`
// runs a package's tests, and nothing a program writes should be able to reach
// it. The import is still here because a `#lang` tag is registered when the file
// that claims it is loaded, and nothing else would load this one.
test :: import "rt/test.nest"

// `types/str.nest` gets no namespace re-export: its one public member is `str`, which
// the prelude already exports, and a `str` namespace sitting beside the `str`
// type would read as the same name meaning two things.
