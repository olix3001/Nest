// Operator traits.
//
// Every operator is sugar for a call to the method of the trait carrying the
// matching `#lang(...)` tag (§6.13); desugaring (`sema::desugar`) reaches each
// trait by its tag, so they must all be declared in this package.

// ===< Arithmetic / bitwise / shift binaries >===

@public Add :: #lang("add") trait <Rhs> {
  Output :: type
  add :: func (self: Self, rhs: Rhs) -> Self.Output
}
@public Sub :: #lang("sub") trait <Rhs> {
  Output :: type
  sub :: func (self: Self, rhs: Rhs) -> Self.Output
}
@public Mul :: #lang("mul") trait <Rhs> {
  Output :: type
  mul :: func (self: Self, rhs: Rhs) -> Self.Output
}
@public Div :: #lang("div") trait <Rhs> {
  Output :: type
  div :: func (self: Self, rhs: Rhs) -> Self.Output
}
@public Rem :: #lang("rem") trait <Rhs> {
  Output :: type
  rem :: func (self: Self, rhs: Rhs) -> Self.Output
}
@public BitAnd :: #lang("bitand") trait <Rhs> {
  Output :: type
  bitand :: func (self: Self, rhs: Rhs) -> Self.Output
}
@public BitOr :: #lang("bitor") trait <Rhs> {
  Output :: type
  bitor :: func (self: Self, rhs: Rhs) -> Self.Output
}
@public BitXor :: #lang("bitxor") trait <Rhs> {
  Output :: type
  bitxor :: func (self: Self, rhs: Rhs) -> Self.Output
}
@public Shl :: #lang("shl") trait <Rhs> {
  Output :: type
  shl :: func (self: Self, rhs: Rhs) -> Self.Output
}
@public Shr :: #lang("shr") trait <Rhs> {
  Output :: type
  shr :: func (self: Self, rhs: Rhs) -> Self.Output
}

// ===< Calls >===

// What can be called with `Args` and answers an `Output` (§5.5): a closure, and
// a function pointer. `Func(i32, i32) -> i32` is how it is written, and that is
// `Func.<Args = (i32, i32), Output = i32>` — the arguments as one tuple, `()`
// for none.
//
// `call` is the one method, Rust's shape: the arguments arrive as the `Args`
// tuple, so `f(x, y)` and `f.call((x, y))` are the same call — which is what
// lets generic code hold arguments it built as data (`std/di` fills the tuple
// by reflection) and still make the call. The compiler is what knows which code
// it reaches — the closure's own body, or the function a `*func` points at — so
// nothing but the compiler implements it.
@public Func :: #lang("func") trait {
  Args :: type
  Output :: type
  call :: func (self: *Self, args: Self.Args) -> Self.Output
}

// Every type whose size is known where it is used — which is every type but a
// trait object, `dyn T`, whose size was erased (§3.4). Nothing but the compiler
// implements it.
//
// It exists for one bound: `<Self: Sized>` on a trait's method says the method
// is for implementing types only, never for `dyn T`. Such a method takes no
// vtable slot, so a generic or by-value method written that way does not stop
// the trait being made into a trait object. A generic parameter is sized
// without saying so: nothing holds a `dyn T` but through a pointer.
@public Sized :: #lang("sized") trait {}

// ===< Prefix unaries >===

@public Neg :: #lang("neg") trait {
  Output :: type
  neg :: func (self: Self) -> Self.Output
}
@public BitNot :: #lang("bitnot") trait {
  Output :: type
  bitnot :: func (self: Self) -> Self.Output
}

// ===< Indexing >===

@public Index :: #lang("index") trait <Idx> {
  Output :: type
  index :: func (self: *Self, i: Idx) -> *Self.Output
}
@public IndexMut :: #lang("index_mut") trait <Idx> {
  Output :: type
  index_mut :: func (self: *mut Self, i: Idx) -> *mut Self.Output
}

// Compound assignment (`a += b`) is not an operator trait: it is pure sugar for
// `a = a + b`, so it needs no `#lang` item — desugaring rewrites it to the simple
// assignment and the resulting `+` lowers through `Add` (§6.13, `sema::desugar`).
// A separate `AddAssign` would let `+=` and `+` disagree for one type, which is a
// difference no reader expects to have to check for.
