// Iteration.
//
// `for x in it { ... }` lowers through `IntoIterator.into_iter` then
// `Iterator.next` (§10).

* :: import "option.nest"
{ Ord, Ordering } :: import "cmp.nest"

// An iterator writes `next`; everything else below comes with it (§10.4).
//
// The **adapters** are lazy: each wraps the iterator (and the closure it was
// given) in a small struct that is an iterator itself, so a chain such as
// `xs.iter().filter(p).map(f)` is one nested type, `Map.<Filter.<SliceIter.<T>,
// P>, F>`, and nothing runs until something calls `next`. Being monomorphized,
// the chain compiles to the loop it stands for. The **consumers** are the ones
// that loop: they pull `next` until it answers `.none`.
//
// Every one of them is `<Self: Sized>` (§3.4): generic, or taking `self` by
// value, none could be a vtable slot, and the bound leaves them out of it — so
// `*mut dyn Iterator.<Item = T>` exists, with `next` its one slot. The
// adapters still apply to one, through the pointer: `*mut I` is an iterator
// itself (below).
@public Iterator :: #lang("iterator") trait {
  Item :: type
  next :: func (self: *mut Self) -> Option.<Self.Item>

  // ===< Adapters >===

  // Each element passed through `f`.
  map :: func <Self: Sized, B, F: Func(Self.Item) -> B> (self: Self, f: F) -> Map.<Self, F> {
    return Map.<Self, F> { iter: self, f: f }
  }

  // Only the elements `keep` answers `true` for.
  filter :: func <Self: Sized, P: Func(Self.Item) -> bool> (self: Self, keep: P) -> Filter.<Self, P> {
    return Filter.<Self, P> { iter: self, keep: keep }
  }

  // Each element with its position, counting from 0: `(0, a), (1, b), …`.
  enumerate :: func <Self: Sized> (self: Self) -> Enumerate.<Self> {
    return Enumerate.<Self> { iter: self, count: 0 }
  }

  // Pairs of this iterator's elements and `other`'s, ending with the shorter.
  zip :: func <Self: Sized, J: Iterator> (self: Self, other: J) -> Zip.<Self, J> {
    return Zip.<Self, J> { a: self, b: other }
  }

  // This iterator's elements, then `other`'s.
  chain :: func <Self: Sized, J: Iterator.<Item = Self.Item>> (self: Self, other: J) -> Chain.<Self, J> {
    return Chain.<Self, J> { a: self, b: other, a_done: false }
  }

  // At most the first `n` elements.
  take :: func <Self: Sized> (self: Self, n: usize) -> Take.<Self> {
    return Take.<Self> { iter: self, left: n }
  }

  // Everything after the first `n` elements.
  skip :: func <Self: Sized> (self: Self, n: usize) -> Skip.<Self> {
    return Skip.<Self> { iter: self, left: n }
  }

  // The first element, then every `n`th after it: `(0..<10).step(3)` is 0, 3,
  // 6, 9. A step of 0 would never move, so it panics.
  step :: func <Self: Sized> (self: Self, n: usize) -> StepBy.<Self> {
    if n == 0 { panic("`step` of 0") }
    return StepBy.<Self> { iter: self, n: n, first: true }
  }

  // Elements while `keep` holds for them, stopping at the first it does not.
  take_while :: func <Self: Sized, P: Func(Self.Item) -> bool> (self: Self, keep: P) -> TakeWhile.<Self, P> {
    return TakeWhile.<Self, P> { iter: self, keep: keep, done: false }
  }

  // The elements after the first ones `pred` holds for.
  skip_while :: func <Self: Sized, P: Func(Self.Item) -> bool> (self: Self, pred: P) -> SkipWhile.<Self, P> {
    return SkipWhile.<Self, P> { iter: self, pred: pred, started: false }
  }

  // The elements of each element in turn, when the elements are themselves
  // iterable: over `[[1, 2], [3]]` it is 1, 2, 3. `J` is the inner iterator,
  // which the `Flatten` impl works out from `Self.Item`.
  flatten :: func <Self: Sized, J> (self: Self) -> Flatten.<Self, J> {
    return Flatten.<Self, J> { iter: self, cur: .none }
  }

  // `f` on each element, then the elements of what it answered — `map(f)`
  // then `flatten()`.
  flat_map :: func <Self: Sized, U: IntoIterator, F: Func(Self.Item) -> U> (self: Self, f: F) -> Flatten.<Map.<Self, F>, U.Iter> {
    return Flatten.<Map.<Self, F>, U.Iter> { iter: self.map(f), cur: .none }
  }

  // One element of look-ahead: `peek` answers what `next` will, without
  // taking it.
  peekable :: func <Self: Sized> (self: Self) -> Peekable.<Self, Self.Item> {
    return Peekable.<Self, Self.Item> { iter: self, peeked: .none }
  }

  // ===< Consumers >===

  // Call `f` on every element.
  each :: func <Self: Sized, F: Func(Self.Item)> (self: Self, f: F) {
    let mut it := self
    loop {
      it.next().match {
        .some(x) => f(x),
        .none => { break },
      }
    }
  }

  // Combine every element into one value, starting from `init`:
  // `(1..=4).fold(0, { acc, x in acc + x })` is 10.
  fold :: func <Self: Sized, A, F: Func(A, Self.Item) -> A> (self: Self, init: A, f: F) -> A {
    let mut it := self
    let mut acc := init
    loop {
      it.next().match {
        .some(x) => { acc = f(acc, x) },
        .none => { break },
      }
    }
    return acc
  }

  // How many elements there are.
  count :: func <Self: Sized> (self: Self) -> usize {
    return self.fold(cast.<usize>(0), { n, x in n + 1 })
  }

  // Whether `pred` holds for some element. Stops at the first that does.
  any :: func <Self: Sized, P: Func(Self.Item) -> bool> (self: Self, pred: P) -> bool {
    let mut it := self
    loop {
      it.next().match {
        .some(x) => { if pred(x) { return true } },
        .none => { return false },
      }
    }
  }

  // Whether `pred` holds for every element. Stops at the first that does not.
  all :: func <Self: Sized, P: Func(Self.Item) -> bool> (self: Self, pred: P) -> bool {
    let mut it := self
    loop {
      it.next().match {
        .some(x) => { if not pred(x) { return false } },
        .none => { return true },
      }
    }
  }

  // Every element, gathered into a collection that says how to build itself
  // from them (`FromIterator`): `.collect.<Vec.<i32>>()`, or a plain
  // `.collect()` where the context names the collection.
  collect :: func <Self: Sized, C: FromIterator.<Item = Self.Item>> (self: Self) -> C {
    return FromIterator.from_iter(self)
  }

  // Combine the elements pairwise, the first standing in for `fold`'s
  // `init`: `(1..=4).reduce({ a, b in a + b })` is `.some(10)`, and an empty
  // iterator's is `.none`.
  reduce :: func <Self: Sized, F: Func(Self.Item, Self.Item) -> Self.Item> (self: Self, f: F) -> Option.<Self.Item> {
    let mut it := self
    return it.next().match {
      .some(first) => .some(it.fold(first, f)),
      .none => .none,
    }
  }

  // The last element.
  last :: func <Self: Sized> (self: Self) -> Option.<Self.Item> {
    let mut it := self
    let mut out: Option.<Self.Item> := .none
    loop {
      it.next().match {
        .some(x) => { out = .some(x) },
        .none => { return out },
      }
    }
  }

  // The greatest element by `cmp`; of equals, the last.
  max_by :: func <Self: Sized, F: Func(Self.Item, Self.Item) -> Ordering> (self: Self, cmp: F) -> Option.<Self.Item> {
    return self.reduce({ a, b in
      cmp(a, b).match {
        .greater => a,
        _ => b,
      }
    })
  }

  // The greatest element; of equals, the last. Only for elements with an
  // order of their own (`Ord`) — a float's goes through `max_by`.
  max :: func <Self: Sized, Self.Item: Ord> (self: Self) -> Option.<Self.Item> {
    return self.max_by({ a, b in a.cmp(b) })
  }

  // The least element; of equals, the first.
  min :: func <Self: Sized, Self.Item: Ord> (self: Self) -> Option.<Self.Item> {
    return self.min_by({ a, b in a.cmp(b) })
  }

  // The least element by `cmp`; of equals, the first.
  min_by :: func <Self: Sized, F: Func(Self.Item, Self.Item) -> Ordering> (self: Self, cmp: F) -> Option.<Self.Item> {
    return self.reduce({ a, b in
      cmp(a, b).match {
        .greater => b,
        _ => a,
      }
    })
  }

  // The first element `pred` holds for.
  find :: func <Self: Sized, P: Func(Self.Item) -> bool> (self: Self, pred: P) -> Option.<Self.Item> {
    let mut it := self
    loop {
      it.next().match {
        .some(x) => { if pred(x) { return .some(x) } },
        .none => { return .none },
      }
    }
  }
}

// ===< The adapters' iterators >===
//
// Each impl names the element type it hands out through its bounds, the way
// the adapter method did: `Map`'s `B` is fixed by `F: Func(I.Item) -> B`, which
// is how the closure's result type becomes the iterator's `Item`.

@public Map :: struct <I, F> {
  iter: I,
  f: F,
}

impl <I: Iterator, B, F: Func(I.Item) -> B> Iterator for Map.<I, F> {
  Item :: B
  next :: func (self: *mut Map.<I, F>) -> Option.<B> {
    return self.iter.next().match {
      .some(x) => .some(self.f(x)),
      .none => .none,
    }
  }
}

@public Filter :: struct <I, P> {
  iter: I,
  keep: P,
}

impl <I: Iterator, P: Func(I.Item) -> bool> Iterator for Filter.<I, P> {
  Item :: I.Item
  next :: func (self: *mut Filter.<I, P>) -> Option.<I.Item> {
    loop {
      self.iter.next().match {
        .some(x) => { if self.keep(x) { return .some(x) } },
        .none => { return .none },
      }
    }
  }
}

@public Enumerate :: struct <I> {
  iter: I,
  count: usize,
}

impl <I: Iterator> Iterator for Enumerate.<I> {
  Item :: (usize, I.Item)
  next :: func (self: *mut Enumerate.<I>) -> Option.<(usize, I.Item)> {
    return self.iter.next().match {
      .some(x) => {
        const i := self.count
        self.count = i + 1
        return .some((i, x))
      },
      .none => .none,
    }
  }
}

@public Zip :: struct <A, B> {
  a: A,
  b: B,
}

impl <A: Iterator, B: Iterator> Iterator for Zip.<A, B> {
  Item :: (A.Item, B.Item)
  next :: func (self: *mut Zip.<A, B>) -> Option.<(A.Item, B.Item)> {
    return self.a.next().match {
      .some(x) => self.b.next().match {
        .some(y) => .some((x, y)),
        .none => .none,
      },
      .none => .none,
    }
  }
}

@public Chain :: struct <A, B> {
  a: A,
  b: B,
  a_done: bool,
}

impl <A: Iterator, B: Iterator.<Item = A.Item>> Iterator for Chain.<A, B> {
  Item :: A.Item
  next :: func (self: *mut Chain.<A, B>) -> Option.<A.Item> {
    if not self.a_done {
      self.a.next().match {
        .some(x) => { return .some(x) },
        .none => { self.a_done = true },
      }
    }
    return self.b.next()
  }
}

@public Take :: struct <I> {
  iter: I,
  left: usize,
}

impl <I: Iterator> Iterator for Take.<I> {
  Item :: I.Item
  next :: func (self: *mut Take.<I>) -> Option.<I.Item> {
    if self.left == 0 { return .none }
    self.left = self.left - 1
    return self.iter.next()
  }
}

@public Skip :: struct <I> {
  iter: I,
  left: usize,
}

impl <I: Iterator> Iterator for Skip.<I> {
  Item :: I.Item
  next :: func (self: *mut Skip.<I>) -> Option.<I.Item> {
    while self.left > 0 {
      self.left = self.left - 1
      self.iter.next().match {
        .some(x) => {},
        .none => { return .none },
      }
    }
    return self.iter.next()
  }
}

@public StepBy :: struct <I> {
  iter: I,
  n: usize,
  first: bool,
}

impl <I: Iterator> Iterator for StepBy.<I> {
  Item :: I.Item
  next :: func (self: *mut StepBy.<I>) -> Option.<I.Item> {
    if self.first {
      self.first = false
      return self.iter.next()
    }
    let mut skip := self.n - 1
    while skip > 0 {
      skip = skip - 1
      self.iter.next().match {
        .some(x) => {},
        .none => { return .none },
      }
    }
    return self.iter.next()
  }
}

@public TakeWhile :: struct <I, P> {
  iter: I,
  keep: P,
  done: bool,
}

impl <I: Iterator, P: Func(I.Item) -> bool> Iterator for TakeWhile.<I, P> {
  Item :: I.Item
  next :: func (self: *mut TakeWhile.<I, P>) -> Option.<I.Item> {
    if self.done { return .none }
    return self.iter.next().match {
      .some(x) => {
        if self.keep(x) { return .some(x) }
        self.done = true
        return .none
      },
      .none => .none,
    }
  }
}

@public SkipWhile :: struct <I, P> {
  iter: I,
  pred: P,
  started: bool,
}

impl <I: Iterator, P: Func(I.Item) -> bool> Iterator for SkipWhile.<I, P> {
  Item :: I.Item
  next :: func (self: *mut SkipWhile.<I, P>) -> Option.<I.Item> {
    if self.started { return self.iter.next() }
    loop {
      self.iter.next().match {
        .some(x) => {
          if not self.pred(x) {
            self.started = true
            return .some(x)
          }
        },
        .none => { return .none },
      }
    }
  }
}

// `cur` is the inner iterator being walked, `.none` between two of them.
@public Flatten :: struct <I, J> {
  iter: I,
  cur: Option.<J>,
}

impl <J: Iterator, U: IntoIterator.<Iter = J>, I: Iterator.<Item = U>> Iterator for Flatten.<I, J> {
  Item :: J.Item
  next :: func (self: *mut Flatten.<I, J>) -> Option.<J.Item> {
    loop {
      self.cur.match {
        .some(j) => {
          let mut inner := j
          const x := inner.next()
          self.cur = .some(inner)
          x.match {
            .some(v) => { return .some(v) },
            .none => { self.cur = .none },
          }
        },
        .none => {},
      }
      self.iter.next().match {
        .some(u) => { self.cur = .some(u.into_iter()) },
        .none => { return .none },
      }
    }
  }
}

// `peeked` is what `peek` took from `iter` and `next` has not handed out yet
// — itself an `Option`, since `peek` may have seen the end.
@public Peekable :: struct <I, T> {
  iter: I,
  peeked: Option.<Option.<T>>,
}

impl <T, I: Iterator.<Item = T>> Iterator for Peekable.<I, T> {
  Item :: T
  next :: func (self: *mut Peekable.<I, T>) -> Option.<T> {
    return self.peeked.match {
      .some(p) => {
        self.peeked = .none
        return p
      },
      .none => self.iter.next(),
    }
  }
}

impl <T, I: Iterator.<Item = T>> Peekable.<I, T> {
  // What `next` will answer, without taking it.
  @public peek :: func (self: *mut Self) -> Option.<T> {
    return self.peeked.match {
      .some(p) => p,
      .none => {
        const p := self.iter.next()
        self.peeked = .some(p)
        return p
      },
    }
  }
}

// A pointer to an iterator is one: `next` advances what it points at. This is
// what puts the adapters within reach of a trait object — `it.map(f)` on a
// `*mut dyn Iterator.<Item = T>` maps the pointer, whose size is known, and
// every `next` it makes goes through the vtable.
impl <I: Iterator> Iterator for *mut I {
  Item :: I.Item
  next :: func (self: *mut *mut I) -> Option.<I.Item> {
    const it: *mut I := self.*
    return it.next()
  }
}

@public IntoIterator :: #lang("into_iterator") trait {
  Iter :: type
  into_iter :: func (self: Self) -> Self.Iter
}

// An iterator is its own `into_iter`, so `for x in xs.iter().map(f)` walks the
// chain directly.
impl <I: Iterator> IntoIterator for I {
  Iter :: I
  into_iter :: func (self: I) -> I { return self }
}

// A collection that can be built from an iterator's elements — what
// `Iterator.collect` hands the work to. The collection says how it is built,
// so `core` needs to know nothing about the collections `std` declares.
@public FromIterator :: trait {
  Item :: type
  from_iter :: func <I: Iterator.<Item = Self.Item>> (it: I) -> Self
}

// Iterating a slice hands out a cursor `SliceIter` over its elements.
@public(all) SliceIter :: struct <T> {
  data: []T,
  pos: usize,
}

// `xs.iter()` — a cursor over a slice's elements, to start a chain from.
impl <T> []T {
  @public iter :: func (self: []T) -> SliceIter.<T> {
    return SliceIter.<T> { data: self, pos: 0 }
  }
}

impl <T> IntoIterator for []T {
  Iter :: SliceIter.<T>
  into_iter :: func (self: []T) -> SliceIter.<T> {
    return SliceIter.<T> { data: self, pos: 0 }
  }
}

// The cursor hands out **elements**, not pointers to them: `for x in xs` binds a
// copy, and writing to it writes to the copy. Iterating for the sake of writing
// — `for p in xs.iter_mut()` — is `SliceIterMut`, below.
impl <T> Iterator for SliceIter.<T> {
  Item :: T
  next :: func (self: *mut SliceIter.<T>) -> Option.<T> {
    if self.pos >= self.data.len() { return .none }
    let v: T := self.data[self.pos]
    self.pos = self.pos + 1
    return .some(v)
  }
}

// `xs.iter_mut()` — a cursor handing out a pointer to each element, so that
// writing through one writes the slice: `for p in xs.iter_mut() { p.* = 0 }`.
@public(all) SliceIterMut :: struct <T> {
  data: []mut T,
  pos: usize,
}

impl <T> []mut T {
  @public iter_mut :: func (self: []mut T) -> SliceIterMut.<T> {
    return SliceIterMut.<T> { data: self, pos: 0 }
  }
}

impl <T> Iterator for SliceIterMut.<T> {
  Item :: *mut T
  next :: func (self: *mut SliceIterMut.<T>) -> Option.<*mut T> {
    if self.pos >= self.data.len() { return .none }
    const at := self.pos
    self.pos = at + 1
    return .some(&mut self.data[at])
  }
}

// Tests run against `core` alone, through its own runner: `just test-core`.
tests :: #when(test) namespace {
  { assert } :: import "fail.nest"
  { make } :: import "mem.nest"

  xs :: func () -> []i32 {
    let out: []mut i32 := make.<[]i32>(5)
    out[0] = 3
    out[1] = 1
    out[2] = 4
    out[3] = 1
    out[4] = 5
    return cast.<[]i32>(out)
  }

  some :: func (o: Option.<i32>, want: i32) -> bool {
    return o.match {
      .some(v) => v == want,
      .none => false,
    }
  }

  @test
  adapters_chain :: func () {
    const n := xs().iter().filter({ x in x > 1 }).map({ x in x * 2 }).fold(0, { a, x in a + x })
    assert(n == 24)
    assert(xs().iter().enumerate().count() == 5)
    assert(xs().iter().skip(1).take(2).fold(0, { a, x in a + x }) == 5)
    assert(xs().iter().step(2).count() == 3)
    assert(xs().iter().zip(xs().iter()).all({ p in p.0 == p.1 }))
    assert(xs().iter().chain(xs().iter()).count() == 10)
  }

  @test
  consumers_answer :: func () {
    assert(some(xs().iter().reduce({ a, b in a + b }), 14))
    assert(some(xs().iter().max(), 5))
    assert(some(xs().iter().min(), 1))
    assert(some(xs().iter().last(), 5))
    assert(some(xs().iter().find({ x in x > 3 }), 4))
    assert(xs().iter().any({ x in x == 4 }))
    assert(not xs().iter().all({ x in x > 1 }))
  }

  @test
  look_ahead_and_nesting :: func () {
    let mut p := xs().iter().peekable()
    assert(some(p.peek(), 3))
    assert(some(p.next(), 3))
    assert(xs().iter().take_while({ x in x != 4 }).count() == 2)
    assert(xs().iter().skip_while({ x in x != 4 }).count() == 3)
    assert(xs().iter().flat_map({ x in xs() }).count() == 25)
  }

  @test
  writing_through_iter_mut :: func () {
    let ys: []mut i32 := make.<[]i32>(3)
    for p in ys.iter_mut() { p.* = 7 }
    assert(ys[0] + ys[1] + ys[2] == 21)
  }
}
