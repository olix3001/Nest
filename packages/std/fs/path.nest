// Paths as text.
//
// Everything here is **lexical**: join two paths, cut one down to its directory,
// and fold `.` and `..` out of one so that a place reached through two spellings
// of its directory is recognised as one place. Nothing here touches the
// filesystem — so a symlink is a different path from its target, and
// `normalize` is not `realpath`.
//
// That is a deliberate split rather than a missing feature. A lexical answer is
// the one a build tool, a manifest reader or a language server wants: it is the
// same on every machine, it needs no syscall, and it cannot fail. What needs the
// filesystem lives in `<std/fs>`.
//
// The separator is `/`. Windows paths are not handled yet.

s :: import "../text/str.nest"
collections :: import "../collections/collections.nest"
{ Vec } :: import "../collections/collections.nest"

SLASH: u8 :: 47

// Whether `p` starts at the root.
@public is_absolute :: func (p: str) -> bool {
  return p.len() > 0 && p.as_bytes()[0] == SLASH
}

// `rel` read from inside `base`. An absolute `rel` is already where it is.
@public join :: func (base: str, rel: str) -> str {
  if is_absolute(rel) || base.len() == 0 { return rel }
  if rel.len() == 0 { return base }
  if s.ends_with(base, "/") { return f"{base}{rel}" }
  return f"{base}/{rel}"
}

// `p` with `.`, `..` and repeated slashes folded out.
//
// A `..` at the top of a relative path has nothing to cancel and is kept; one
// at the root of an absolute path is dropped, because the root is its own
// parent.
@public normalize :: func (p: str) -> str {
  let absolute: bool := is_absolute(p)
  let mut kept: Vec.<str> := collections.vec.new.<str>()
  for part in s.split(p, "/") {
    if part == "" || part == "." { continue }
    if part == ".." {
      let top: str := if kept.len() > 0 { kept.get(kept.len() - 1).! } else { ".." }
      if top != ".." {
        kept.pop().match { .some(_) => (), .none => () }
      } else if absolute == false {
        kept.push(part)
      }
      continue
    }
    kept.push(part)
  }
  let body: str := s.join(kept.as_slice(), "/")
  if absolute { return f"/{body}" }
  if body.len() == 0 { return "." }
  return body
}

// The directory `p` is in: everything before its last slash. The root's parent
// is the root, and a name with no slash is in `.`. `p` is normalized, so it has
// no trailing slash to cut at instead.
@public parent :: func (p: str) -> str {
  return s.rfind(p, "/").match {
    .some(0) => "/",
    .some(at) => s.slice(p, 0, at),
    .none => ".",
  }
}

// `p` as seen from `base`, when it is inside it; otherwise `p` as it is.
@public relative_to :: func (p: str, base: str) -> str {
  if p == base { return "." }
  let prefix: str := if s.ends_with(base, "/") { base } else { f"{base}/" }
  if s.starts_with(p, prefix) { return s.slice(p, prefix.len(), p.len()) }
  return p
}

// The last component of `p`, which is normalized.
@public file_name :: func (p: str) -> str {
  return s.rfind(p, "/").match {
    .some(at) => s.slice(p, at + 1, p.len()),
    .none => p,
  }
}

// The tests, in a namespace of their own.
//
// They sit beside what they test — an inner namespace sees the file's private
// names — and they are gathered rather than scattered, so that what a reader
// skips is one block and not every third declaration. When there is conditional
// compilation, this is the namespace to compile only in a test build.
tests :: #when(test) namespace {
    @test
    joining :: func () {
        assert(join("a", "b") == "a/b")
        assert(join("a/", "b") == "a/b")
        assert(join("a", "/b") == "/b", "an absolute right side is already where it is")
        assert(join("", "b") == "b")
        assert(join("a", "") == "a")
    }

    @test
    normalizing :: func () {
        assert(normalize("a/./b") == "a/b")
        assert(normalize("a//b") == "a/b")
        assert(normalize("a/b/../c") == "a/c")
        assert(normalize("/..") == "/", "the root is its own parent")
        assert(normalize("../a") == "../a", "a relative `..` has nothing to cancel")
        assert(normalize("a/..") == ".")
    }

    @test
    naming :: func () {
        assert(parent("/a/b") == "/a")
        assert(parent("/a") == "/")
        assert(parent("a") == ".")
        assert(file_name("/a/b") == "b")
        assert(file_name("b") == "b")
        assert(relative_to("/a/b", "/a") == "b")
        assert(relative_to("/a", "/a") == ".")
        assert(relative_to("/c", "/a") == "/c")
    }
}
