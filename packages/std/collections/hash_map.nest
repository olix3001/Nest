// `HashMap.<K, V>`: a table keyed by anything that can be hashed and compared.
//
// It does not shrink and it does not keep insertion order. Each of those is a
// real thing to want and neither is needed by what `std` exists for yet
// (`design/toolchain.md`: the floor `twig` and the language server stand on).
//
//     { HashMap } :: import <std/collections>
//     hash_map :: import <std/collections/hash_map>
//
//     let mut m: HashMap.<str, i32> := hash_map.new.<str, i32>()

{ make, copy_nonoverlapping, set_bytes } :: import <core/mem>
{ Eq } :: import <core/cmp>
{ Iterator, IntoIterator, FromIterator, SliceIter, SliceIterMut } :: import <core/iter>
{ Hash } :: import "hash.nest"

// ===< HashMap >===

// A slot's state. A byte per slot rather than a sentinel key, because there is
// no value of an arbitrary `K` this table is entitled to reserve.
EMPTY:    u8 :: 0
OCCUPIED: u8 :: 1
// A slot whose entry was removed. It is not `EMPTY`, because a probe that
// stopped here would miss every key that had to walk past this slot on the way
// in.
DELETED:  u8 :: 2

/// A table from keys `K` to values `V`. A key is anything `Hash` and `Eq`: the
/// integers, `bool`, `char`, `str` and `String`, or a type of your own that
/// implements both.
///
/// ```nest
/// { HashMap } :: import <std/collections>
/// hash_map :: import <std/collections/hash_map>
///
/// let mut ages: HashMap.<str, i32> := hash_map.new.<str, i32>()
/// ages.insert("ada", 36)
/// const a: Option.<i32> := ages.get("ada")
/// for (name, age) in ages { io.println(f"{name}: {age}") }
/// ```
///
/// Iteration order is the table's, not insertion order, and the table does not
/// shrink.
///
/// **Open addressing with linear probing**: the entries live in the table rather
/// than in a chain off each bucket, so a lookup is one cache line most of the
/// time and there is no allocation per entry. The capacity is a power of two, so
/// the bucket is a mask rather than a division.
@public HashMap :: struct <K, V> {
  slot_keys: []mut K,
  slot_values: []mut V,
  state: []mut u8,
  // How many slots hold an entry. `count` rather than `len` for the reason
  // `Vec`'s is.
  count: usize,
  // How many are not `EMPTY` — entries plus tombstones. This is what the load
  // factor is measured against, because a probe walks past both.
  used: usize,
}

/// An empty table, with no storage until the first insert.
@public new :: func <K, V> () -> HashMap.<K, V> {
  return HashMap.<K, V> {
    slot_keys: make.<[]K>(0),
    slot_values: make.<[]V>(0),
    state: make.<[]u8>(0),
    count: 0,
    used: 0,
  }
}

impl <K: Hash + Eq, V> HashMap.<K, V> {
  @public len :: #inline func (self: *Self) -> usize { return self.count }
  @public is_empty :: #inline func (self: *Self) -> bool { return self.count == 0 }

  // Where `key` is, or where it would go.
  //
  // It answers the **first tombstone** it walked past when the key is absent,
  // so that re-inserting a removed key reuses its slot rather than lengthening
  // the probe. `found` is what says which of the two answers this is.
  probe :: func (self: *Self, key: K) -> Probe {
    let mask: usize := self.state.len() - 1
    let mut at: usize := cast.<usize>(key.hash()) & mask
    let mut first_free: usize := self.state.len()
    loop {
      let s: u8 := self.state[at]
      if s == EMPTY {
        if first_free < self.state.len() { return Probe { at: first_free, found: false } }
        return Probe { at: at, found: false }
      }
      if s == DELETED {
        if first_free == self.state.len() { first_free = at }
      } else {
        if self.slot_keys[at].eq(key) { return Probe { at: at, found: true } }
      }
      at = (at + 1) & mask
    }
  }

  // Grow, and re-place every entry.
  //
  // Rehashing is what drops the tombstones: a probe walks past a `DELETED`
  // slot, so a table that removed as often as it inserted would slow to a walk
  // without ever holding more entries. The new table has no tombstones at all.
  grow :: func (self: *mut Self) -> void {
    let mut cap: usize := self.state.len() * 2
    if cap < 8 { cap = 8 }
    let old_keys: []mut K := self.slot_keys
    let old_values: []mut V := self.slot_values
    let old_state: []mut u8 := self.state
    self.slot_keys = make.<[]K>(cap)
    self.slot_values = make.<[]V>(cap)
    self.state = make.<[]u8>(cap)
    self.count = 0
    self.used = 0
    for i in 0..<old_state.len() {
      if old_state[i] == OCCUPIED {
        // The answer is always `.none` — a rehash into a fresh table cannot
        // find a key already there — and a `match` that says so is how a
        // value-returning call is used as a statement.
        self.insert(old_keys[i], old_values[i]).match { .some(_) => (), .none => () }
      }
    }
  }

  /// Put `value` under `key`, answering what was there before.
  ///
  /// It grows when the table is **three-quarters used**, counting tombstones:
  /// past that, linear probing's probe lengths stop being short, which is the
  /// one thing it depends on.
  @public insert :: func (self: *mut Self, key: K, value: V) -> Option.<V> {
    if (self.used + 1) * 4 > self.state.len() * 3 { self.grow() }
    let p: Probe := self.probe(key)
    if p.found {
      let held: V := self.slot_values[p.at]
      self.slot_values[p.at] = value
      return .some(held)
    }
    if self.state[p.at] == EMPTY { self.used = self.used + 1 }
    self.state[p.at] = OCCUPIED
    self.slot_keys[p.at] = key
    self.slot_values[p.at] = value
    self.count = self.count + 1
    return .none
  }

  /// What is under `key`, or `.none`.
  @public get :: func (self: *Self, key: K) -> Option.<V> {
    if self.count == 0 { return .none }
    let p: Probe := self.probe(key)
    if p.found { return .some(self.slot_values[p.at]) }
    return .none
  }

  /// Whether `key` is in the table.
  @public contains :: func (self: *Self, key: K) -> bool {
    return self.get(key).match { .some(_) => true, .none => false }
  }

  /// Take `key` out, answering what it held.
  ///
  /// The slot becomes a tombstone rather than empty, so that a key which probed
  /// past it is still reachable. `used` does not drop, which is what makes a
  /// remove-and-insert cycle eventually rehash instead of degrading.
  @public remove :: func (self: *mut Self, key: K) -> Option.<V> {
    if self.count == 0 { return .none }
    let p: Probe := self.probe(key)
    if p.found == false { return .none }
    let held: V := self.slot_values[p.at]
    self.state[p.at] = DELETED
    self.count = self.count - 1
    return .some(held)
  }

  /// Every key, in no particular order. A fresh list, because the keys are
  /// scattered through the table rather than laid out end to end.
  @public keys_of :: func (self: *Self) -> []K {
    let out: []mut K := make.<[]K>(self.count)
    let mut have: usize := 0
    for i in 0..<self.state.len() {
      if self.state[i] == OCCUPIED {
        out[have] = self.slot_keys[i]
        have = have + 1
      }
    }
    return cast.<[]K>(out)
  }

  /// Forget every entry, keeping the storage.
  @public clear :: func (self: *mut Self) -> void {
    for i in 0..<self.state.len() { self.state[i] = EMPTY }
    self.count = 0
    self.used = 0
  }
}

// ===< Walking a table >===
//
// The entries are scattered through the table, so every iterator here walks
// the slots and skips the ones that hold nothing, in no particular order. Each
// hands out **copies**, as `SliceIter` does — except `iter_mut`, whose values
// are pointers into the table, so that writing through one writes the entry.

impl <K, V> HashMap.<K, V> {
  /// Every `(key, value)`.
  @public iter :: func (self: *Self) -> MapIter.<K, V> {
    return MapIter.<K, V> { slot_keys: self.slot_keys, slot_values: self.slot_values, state: self.state, pos: 0 }
  }

  /// Every key, with a pointer to its value.
  @public iter_mut :: func (self: *mut Self) -> MapIterMut.<K, V> {
    return MapIterMut.<K, V> { slot_keys: self.slot_keys, slot_values: self.slot_values, state: self.state, pos: 0 }
  }

  /// Every key.
  @public keys :: func (self: *Self) -> impl Iterator.<Item = K> {
    return self.iter().map({ e in e.0 })
  }

  /// Every value.
  @public values :: func (self: *Self) -> impl Iterator.<Item = V> {
    return self.iter().map({ e in e.1 })
  }
}

@public MapIter :: struct <K, V> {
  slot_keys: []K,
  slot_values: []V,
  state: []u8,
  pos: usize,
}

impl <K, V> Iterator for MapIter.<K, V> {
  Item :: (K, V)
  next :: func (self: *mut MapIter.<K, V>) -> Option.<(K, V)> {
    while self.pos < self.state.len() {
      const at := self.pos
      self.pos = at + 1
      if self.state[at] == OCCUPIED { return .some((self.slot_keys[at], self.slot_values[at])) }
    }
    return .none
  }
}

@public MapIterMut :: struct <K, V> {
  slot_keys: []K,
  slot_values: []mut V,
  state: []u8,
  pos: usize,
}

impl <K, V> Iterator for MapIterMut.<K, V> {
  Item :: (K, *mut V)
  next :: func (self: *mut MapIterMut.<K, V>) -> Option.<(K, *mut V)> {
    while self.pos < self.state.len() {
      const at := self.pos
      self.pos = at + 1
      if self.state[at] == OCCUPIED { return .some((self.slot_keys[at], &mut self.slot_values[at])) }
    }
    return .none
  }
}

// `for (k, v) in m` — the entries the table holds when the loop starts.
impl <K, V> IntoIterator for HashMap.<K, V> {
  Iter :: MapIter.<K, V>
  into_iter :: func (self: HashMap.<K, V>) -> MapIter.<K, V> {
    return MapIter.<K, V> { slot_keys: self.slot_keys, slot_values: self.slot_values, state: self.state, pos: 0 }
  }
}

// `pairs.collect.<HashMap.<K, V>>()` — a later pair under an earlier key
// replaces it, as `insert` does.
impl <K: Hash + Eq, V> FromIterator for HashMap.<K, V> {
  Item :: (K, V)
  from_iter :: func <I: Iterator.<Item = (K, V)>> (it: I) -> HashMap.<K, V> {
    let mut m := new.<K, V>()
    for e in it { m.insert(e.0, e.1).match { .some(_) => (), .none => () } }
    return m
  }
}

// What `probe` answers: a slot, and whether the key is already in it.
Probe :: struct {
  at: usize,
  found: bool,
}

tests :: #when(test) namespace {
    @test
    a_map_is_walked :: func () {
        let mut m := new.<i32, i32>()
        for i in 0..<5 { m.insert(i, i * i).match { .some(_) => (), .none => () } }
        let mut keys := 0
        let mut values := 0
        for e in m.iter() {
            keys = keys + e.0
            values = values + e.1
        }
        assert(keys == 10)
        assert(values == 30)
        assert(m.keys().count() == 5)
        assert(m.values().fold(0, { a, x in a + x }) == 30)
        for e in m.iter_mut() { e.1.* = 0 }
        assert(m.values().all({ x in x == 0 }))
        let mut n := 0
        for e in m { n = n + 1 }
        assert(n == 5)
    }

    @test
    a_map_is_collected :: func () {
        const xs := [_]i32 { 1, 2, 3 }
        const m := xs[..].iter().map({ x in (x, x * 2) }).collect.<HashMap.<i32, i32>>()
        assert(m.len() == 3)
        assert(m.get(2).match { .some(v) => v == 4, .none => false })
    }
}
