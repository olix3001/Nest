// Handler parameters that come from the request rather than from a
// registration: each is a `di.Resolve` type, so a handler names it after `ctx`
// and `std/di` builds it for the request being answered.
//
//     app.post("/users") { ctx, user: http.Json.<User>, repo: *Repo in
//         repo.add(user)
//         http.text("added")
//     }
//
// One that cannot be built fails with a `Rejection` — a body that is not the
// JSON `T` wants is a `400` — and the router answers with it instead of
// running the handler. `std/di` carries the `Rejection` as its error's cause
// and knows nothing about what is in it.

di :: import "../di/di.nest"
json :: import "../serialize/json/json.nest"
{ Decode } :: import "../serialize/decode.nest"
{ Encode } :: import "../serialize/encode.nest"
{ Header, IntoResponse, Response, json_of, same_ascii, with_body } :: import "message.nest"
{ Context } :: import "router.nest"

/// Why a request could not supply a handler's parameter: the response to send
/// instead. What every extractor here fails with (`di.Resolve.Failure`), and
/// what one written elsewhere should fail with for the router to answer it.
@public(all) Rejection :: struct {
    status: u16,
    message: str,
}

impl IntoResponse for Rejection {
    into_response :: func (self: Rejection) -> Response {
        // `status` and `message` here are this struct's own fields.
        return with_body(self.status, "text/plain; charset=utf-8", self.message.as_bytes())
    }
}

// The request's `*Context`, which every request's scope is given.
context :: func (sp: *mut di.Scope) -> Result.<*Context, Rejection> {
    return sp.get.<Context>().match {
        .ok(c) => .ok(c),
        .err(e) => .err(Rejection { status: 500, message: e.message }),
    }
}

/// The request's body, decoded as JSON into a `T` — and, as a handler's
/// answer, a `T` written as JSON. It lends the `T`: `user.name` is the decoded
/// `User`'s `name`, and a `Json.<User>` is a `User` wherever one is wanted.
@public Json :: struct <T> {
    @using _value: T,
}

impl <T> Json.<T> {
    /// `value`, to be answered as JSON: `(201, http.Json.of(user))`.
    @public of :: func (value: T) -> Json.<T> { return Json { _value: value } }
}

impl <T: Decode> di.Resolve for Json.<T> {
    Failure :: Rejection
    resolve :: func (self: *mut Self, sp: *mut di.Scope) -> Result.<void, Rejection> {
        const ctx: *Context := context(sp).?
        self._value = json.from_str.<T>(ctx.body()).match {
            .ok(v) => v,
            .err(e) => {
                return .err(Rejection { status: 400, message: f"the body is not valid JSON for this request: {e}" })
            },
        }
        return .ok(())
    }
}

/// As an answer: the value written as JSON, or a `500` when it cannot be.
impl <T: Encode> IntoResponse for Json.<T> {
    into_response :: func (self: Json.<T>) -> Response { return json_of(self._value) }
}

/// The request's body, as text.
@public(all) Body :: struct {
    text: str,
}

impl di.Resolve for Body {
    Failure :: Rejection
    resolve :: func (self: *mut Body, sp: *mut di.Scope) -> Result.<void, Rejection> {
        self.text = context(sp).?.body()
        return .ok(())
    }
}

/// The request's headers.
@public(all) Headers :: struct {
    list: []Header,
}

impl Headers {
    /// The value of header `name`, matched without regard to case.
    @public get :: func (self: *Self, name: str) -> Option.<str> {
        for h in self.list {
            if same_ascii(h.name, name) { return .some(h.value) }
        }
        return .none
    }
}

impl di.Resolve for Headers {
    Failure :: Rejection
    resolve :: func (self: *mut Headers, sp: *mut di.Scope) -> Result.<void, Rejection> {
        self.list = context(sp).?.request().headers
        return .ok(())
    }
}
