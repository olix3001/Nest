// A small web framework: routes answered by closures, and services from
// `std/di` handed to them per request. Ktor's shape:
//
//     http :: import <std/http>
//     di :: import <std/di>
//
//     let mut services: di.Services := di.services()
//     services.add_singleton({ sp in Greeter { greeting: "hello" } })
//
//     let mut app: http.App := http.app(services.build())
//     app.get("/") { ctx in http.html("<h1>home</h1>") }
//     app.route("/api") { r in
//         r.get("/hello/:name") { ctx, g: *Greeter in
//             f"{g.greeting}, {ctx.param("name")}"
//         }
//         r.post("/echo") { ctx in ctx.body() }
//     }
//     app.listen("127.0.0.1:8080").!
//
// A handler's first parameter is the request's `*Context`, with its type left
// out. It takes **whatever parameters it wants** after that, and each is
// resolved from the request's scope (`std/di`'s `invoke_with`): a service it
// depends on. Those are written with their types, because that is what they
// are resolved by.
//
// A handler answers anything that is `IntoResponse`: text, a `Response`, a
// `Json`, `(status, value)`, `void` (`204`), an `Option` (`.none` is `404`) or
// a `Result` of those, so `.?` answers its error.
//
// Every request is served in a **scope** of its own (`di.Scope.scope()`), so a
// scoped service — a unit of work, a request's user — is built once per request
// and a singleton once per application.
//
// `App.respond(http.request("GET", "/api/hello/ada"))` answers a request
// without a socket, which is how an application's routes are tested.
//
// **Middleware** wraps the routes registered after it, on its router and the
// routers `route` makes from it — logging, authentication, headers:
//
//     app.use { ctx, next in
//         const res := next.run(ctx)
//         io.println(f"{ctx.request().method} {ctx.request().path} {res.status}")
//         res
//     }
//
// What is here is the floor: one connection at a time, one request per
// connection, bodies with a `Content-Length`. Keep-alive and concurrency are
// additions to `server.nest` that leave the handler's side — a `Context` in, a
// `Response` out — as it is.

@public { Header, IntoResponse, Request, Response, request, text, html, json_of, status, not_found, with_body, reason } :: import "message.nest"
@public { Handler, Middleware, Next, Context, Router, App, app } :: import "router.nest"
@public { MAX_REQUEST } :: import "server.nest"
@public { Json, Body, Headers, Rejection } :: import "extract.nest"

tests :: #when(test) namespace {
    di :: import "../di/di.nest"
    net :: import "../net/net.nest"
    io :: import "../io/io.nest"
    strs :: import "../text/str.nest"
    { rename } :: import "../serialize/attrs.nest"

    Greeter :: struct { greeting: str }
    Missing :: struct { n: i32 }

    make_app :: func () -> App {
        let mut services: di.Services := di.services()
        services.add_singleton({ sp in Greeter { greeting: "hello" } })
        let mut a: App := app(services.build())
        a.use { ctx, next in next.run(ctx).header("X-Served-By", "nest") }
        a.get("/") { ctx in text("home") }
        a.route("/api") { r in
            r.use { ctx, next in
                ctx.header("Authorization").match {
                    .some(_) => next.run(ctx),
                    .none => status(401, "who are you?"),
                }
            }
            r.get("/hello/:name") { ctx, g: *Greeter in
                text(f"{g.greeting}, {ctx.param("name")}")
            }
            r.get("/service") { ctx in
                const g: *Greeter := ctx.service.<Greeter>().!
                text(g.greeting)
            }
            r.post("/echo") { ctx in text(ctx.body()) }
            r.get("/files/*") { ctx in text(ctx.param("*")) }
            r.get("/missing") { ctx, m: *Missing in text("?") }
        }
        return a
    }

    with_auth :: func (method: str, target: str) -> Request {
        let mut r: Request := request(method, target)
        const hs: []Header := .{ Header { name: "authorization", value: "yes" } }
        r.headers = hs
        return r
    }

    @test
    routes_match :: func () {
        let mut a: App := make_app()
        assert(a.respond(request("GET", "/")).text() == "home")
        assert(a.respond(with_auth("GET", "/api/hello/ada")).text() == "hello, ada")
        assert(a.respond(with_auth("GET", "/api/files/a/b.txt")).text() == "a/b.txt")
        assert(a.respond(with_auth("GET", "/api/service")).text() == "hello")
        assert(a.respond(with_auth("GET", "/api/missing")).status == 500, "a parameter nothing supplies")
        assert(a.respond(request("GET", "/nope")).status == 404)
        assert(a.respond(request("DELETE", "/")).status == 405)
    }

    @test
    middleware_wraps_routes :: func () {
        let mut a: App := make_app()
        const denied: Response := a.respond(request("GET", "/api/hello/ada"))
        assert(denied.status == 401, "the `/api` middleware answers by itself")
        const home: Response := a.respond(request("GET", "/"))
        let mut served := false
        for h in home.headers.iter() {
            if h.name == "X-Served-By" { served = true }
        }
        assert(served, "the app's middleware changes what comes back")
    }

    User :: struct { name: str, age: i32 }

    posting :: func (target: str, body: str) -> Request {
        let mut r: Request := request("POST", target)
        const hs: []Header := .{ Header { name: "X-Tag", value: "t1" } }
        r.headers = hs
        r.body = body.as_bytes()
        return r
    }

    @test
    handlers_take_the_request_s_parts :: func () {
        let mut a: App := make_app()
        a.post("/user") { ctx, u: Json.<User>, g: *Greeter in
            text(f"{g.greeting} {u.name} ({u.age})")
        }
        a.post("/raw") { ctx, b: Body, h: Headers in
            text(f"{b.text} {h.get("x-tag").match { .some(v) => v, .none => "-" }}")
        }
        const ok: Response := a.respond(posting("/user", "{\"name\": \"ada\", \"age\": 36}"))
        assert(ok.status == 200 && ok.text() == "hello ada (36)", ok.text())
        const bad: Response := a.respond(posting("/user", "{\"name\": 5}"))
        assert(bad.status == 400, "a body that is not the `T` is the client's mistake")
        assert(a.respond(posting("/raw", "hi")).text() == "hi t1")
    }

    @test
    a_handler_decodes_a_type_local_to_its_function :: func () {
        let mut a: App := make_app()
        ExampleJson :: struct {
            @rename("username") name: str,
            surname: str,
        }
        a.post("/json") { ctx, data: Json.<ExampleJson> in
            text(f"{data.name} {data.surname}")
        }
        const res: Response := a.respond(posting("/json", "{\"username\": \"ada\", \"surname\": \"lovelace\"}"))
        assert(res.status == 200 && res.text() == "ada lovelace", res.text())
    }

    named :: func (name: str) -> Result.<str, Rejection> {
        if name == "" { return .err(Rejection { status: 422, message: "a name is needed" }) }
        return .ok(name)
    }

    @test
    handlers_answer_anything_into_a_response :: func () {
        let mut a: App := make_app()
        a.get("/str") { ctx in "plain" }
        a.get("/created") { ctx in (201, Json.of(User { name: "ada", age: 36 })) }
        a.get("/empty") { ctx in () }
        a.get("/maybe/:n") { ctx in
            if ctx.param("n") == "1" { return .some("one") }
            return .none
        }
        a.get("/checked/:n") { ctx in
            if ctx.param("n") == "0" { return .err((400, "zero")) }
            return .ok("fine")
        }
        a.get("/nested") { ctx in (201, (202, "inner")) }
        a.get("/teapot") { ctx -> Result.<str, Rejection> in
            .err(Rejection { status: 418, message: "teapot" })
        }
        a.post("/named") { ctx, u: Json.<User> in
            const name: str := named(u.name).?
            return .ok((201, name))
        }
        const nested: Response := a.respond(request("GET", "/nested"))
        assert(nested.status == 201 && nested.text() == "inner", "the outer status wins")
        assert(a.respond(request("GET", "/teapot")).status == 418)
        const ada: Response := a.respond(posting("/named", "{\"name\": \"ada\", \"age\": 1}"))
        assert(ada.status == 201 && ada.text() == "ada", ada.text())
        const empty: Response := a.respond(posting("/named", "{\"name\": \"\", \"age\": 1}"))
        assert(empty.status == 422, "`.?` answers the handler's own rejection")
        assert(a.respond(posting("/named", "nope")).status == 400, "the extractor's rejection")
        const created: Response := a.respond(request("GET", "/created"))
        assert(created.status == 201 && created.text() == "{\"name\":\"ada\",\"age\":36}", created.text())
        assert(a.respond(request("GET", "/str")).text() == "plain")
        assert(a.respond(request("GET", "/empty")).status == 204)
        assert(a.respond(request("GET", "/maybe/1")).text() == "one")
        assert(a.respond(request("GET", "/maybe/2")).status == 404)
        assert(a.respond(request("GET", "/checked/1")).text() == "fine")
        const zero: Response := a.respond(request("GET", "/checked/0"))
        assert(zero.status == 400 && zero.text() == "zero", zero.text())
    }

    @test
    middleware_answers_anything_into_a_response :: func () {
        let mut a: App := make_app()
        a.use { ctx, next -> Result.<Response, (u16, str)> in
            ctx.header("X-Key").match {
                .some(_) => .ok(next.run(ctx)),
                .none => .err((403, "no key")),
            }
        }
        a.get("/guarded") { ctx in "in" }
        assert(a.respond(request("GET", "/guarded")).status == 403)
        let mut r: Request := request("GET", "/guarded")
        const hs: []Header := .{ Header { name: "X-Key", value: "k" } }
        r.headers = hs
        assert(a.respond(r).text() == "in")
    }

    @test
    queries_and_headers :: func () {
        const r: Request := request("GET", "/x?a=1&b=two")
        assert(r.path == "/x")
        assert(r.query_param("b").match { .some(v) => v == "two", .none => false })
        assert(r.query_param("c").match { .some(_) => false, .none => true })
    }

    // A server and its client in one process: the client's request sits in
    // the socket's buffer until `serve_one` reads it.
    @test
    a_request_is_served_over_tcp :: func () -> Result.<void, io.Error> {
        let mut a: App := make_app()
        let mut server: net.TcpListener := net.listen("127.0.0.1:0").?
        let mut client: net.TcpStream := net.connect(server.local_addr().?).?
        const body: str := "echo me"
        io.write_all(&mut client, f"POST /api/echo HTTP/1.1\r\nHost: x\r\nAuthorization: y\r\nContent-Length: {body.len()}\r\n\r\n{body}".as_bytes()).?
        a.serve_one(&mut server).?
        const got: str := cast.<str>(io.read_to_end(&mut client).?)
        assert(strs.starts_with(got, "HTTP/1.1 200 OK\r\n"), got)
        assert(strs.ends_with(got, "\r\n\r\necho me"), got)
        client.close().?
        server.close().?
        return .ok(())
    }
}
