// The C library, declared and not wrapped.
//
// Everything `std` does on a hosted target happens through one of these. They
// are **exposed rather than hidden** (`design/toolchain.md` stage 2) for two
// reasons, and the second is the one that matters: a program needing an
// `ioctl` this library never wrapped should be able to declare its call site
// against the same vocabulary instead of re-deriving it, and the wrappers above
// are then demonstrably ordinary Nest code rather than compiler magic.
//
// **The types are `core/c`'s**, which means they are aliases of the language's
// own (`c.int` *is* `i32`) and a value crosses with no conversion on either
// end. A pointer is the exception: a `c.ptr.<T>` is one address, untraced, and
// converting to a `*T` is a checked call — see `core/c`.
//
// **`open` is variadic**, and is declared as one. `#c_vararg` says the declared
// parameters are C's *fixed* ones and that a call may pass a tail beyond them,
// which is what `open`'s `mode` is — read only when the flags ask to create.
// The distinction is not cosmetic: on arm64 a fixed argument arrives in a
// register and a variadic one on the stack, so a three-parameter declaration
// of it creates files with whatever the stack held.
//
// **This is the POSIX surface**, and it is what `std` is written on today:
// Linux, macOS and the BSDs. A Windows backing is a second file under `sys`
// rather than a change here, which is the whole reason `sys` is a layer at all.
//
// **What differs per target** was written before `#when` existed, so some of
// it is not here: `errno` is a macro rather than a symbol, and
// `struct stat` and `struct dirent` have layouts that differ between Linux and
// macOS. What each of those costs `std` is written where `std` goes without it.
// The four `open` flags that differ are the one case handled rather than
// dropped — see below.

c :: import <core/c>
{ OS } :: import <core/target>
{ Os } :: import <core/os>

// ===< The runtime's own >===
//
// Three functions from `runtime/nest_runtime.c`, which is linked into every
// program this compiler produces. They are here rather than in a namespace of
// their own because what they are is C functions this program links against,
// which is what this file is.

extern("c") {
  /// `errno`, which cannot be declared: see `nest_errno` in the runtime.
  @public nest_errno :: func () -> c.int

  /// The **live** environment table. Not `envp`, which is a snapshot `setenv`
  /// replaces from under a program: this reads `environ`, which macOS hides
  /// behind a feature macro that keeps a dynamic executable from linking against
  /// it directly. `argc` and `argv` are not here — the entry point hands those
  /// to `#lang("start")`, which is `sys.start`.
  @public nest_envp :: func () -> c.ptr.<c.cstr>

  /// A directory's entries, one name at a time. `struct dirent` is one of the
  /// layouts that differ between Linux and macOS (see above), so the runtime
  /// reads `d_name` out of it and hands over only that: `nest_dir_open` is
  /// `opendir`, `nest_dir_next` the next name or null at the end, and
  /// `nest_dir_close` is `closedir`.
  @public nest_dir_open :: func (path: c.cstr) -> c.ptr.<c.anyopaque>
  @public nest_dir_next :: func (dir: c.ptr.<c.anyopaque>) -> c.cstr
  @public nest_dir_close :: func (dir: c.ptr.<c.anyopaque>) -> c.int
}

// ===< Files and descriptors >===

extern("c") {
  /// `open`'s `mode` is the tail: C reads it only when the flags ask to create a
  /// file, and a caller that is not creating one passes nothing. Everything else
  /// on this list is fixed-arity in C and is declared as itself.
  @public open  :: #c_vararg func (path: c.cstr, flags: c.int) -> c.int
  @public close :: func (fd: c.int) -> c.int
  @public read  :: func (fd: c.int, buf: c.ptr.<c.uchar>, n: c.size_t) -> c.ssize_t
  @public write :: func (fd: c.int, buf: c.ptr.<c.uchar>, n: c.size_t) -> c.ssize_t
  @public lseek :: func (fd: c.int, off: c.longlong, whence: c.int) -> c.longlong
  @public isatty :: func (fd: c.int) -> c.int
  @public pipe  :: func (fds: c.ptr.<c.int>) -> c.int
  @public dup2  :: func (from: c.int, to: c.int) -> c.int

  @public unlink :: func (path: c.cstr) -> c.int
  @public rename :: func (from: c.cstr, to: c.cstr) -> c.int
  @public mkdir  :: func (path: c.cstr, mode: c.uint) -> c.int
  @public rmdir  :: func (path: c.cstr) -> c.int
  @public access :: func (path: c.cstr, mode: c.int) -> c.int
  @public getcwd :: func (buf: c.ptr.<c.uchar>, n: c.size_t) -> c.cstr
}

// `lseek`'s offset is `off_t`, which is 64 bits on both targets here — macOS
// has no 32-bit `off_t` and Linux is built `_FILE_OFFSET_BITS=64` — so
// `c.longlong` is the honest spelling rather than a guess.

// ===< Processes >===

extern("c") {
  @public fork    :: func () -> c.int
  @public execvp  :: func (file: c.cstr, argv: c.ptr.<c.cstr>) -> c.int
  @public waitpid :: func (pid: c.int, status: c.ptr.<c.int>, options: c.int) -> c.int
  @public _exit   :: func (status: c.int) -> never
  @public exit    :: func (status: c.int) -> never
}

// ===< The environment >===

extern("c") {
  @public getenv   :: func (name: c.cstr) -> c.cstr
  @public setenv   :: func (name: c.cstr, value: c.cstr, overwrite: c.int) -> c.int
  @public unsetenv :: func (name: c.cstr) -> c.int
}

// ===< Messages >===

extern("c") {
  /// The message for an `errno`. It returns a pointer into storage the library
  /// owns, which is why `std/io`'s `Error` copies the bytes out rather than
  /// keeping the pointer.
  @public strerror :: func (code: c.int) -> c.cstr
}

// ===< Numbers as text >===

extern("c") {
  /// `std/serialize` finds a float's text the way `core/fmt` does — `snprintf`
  /// at rising precision until `strtod` reads the same bits back. Both declare
  /// these two, which is fine: two `extern("c")` declarations of one symbol are
  /// declarations of the same function, and codegen emits one global for them.
  @public snprintf :: #c_vararg func (buf: c.ptr.<c.uchar>, n: c.size_t, fmt: c.cstr) -> c.int
  @public strtod   :: func (s: c.cstr, end: c.ptr.<c.cstr>) -> c.double
}

// ===< The constants >===
//
// Written out rather than read from a header, because there is no header to
// read: `nestc` has no C preprocessor. Most of these are the same number on
// every target below — POSIX fixes them — and the four that are not are the
// `open` flags, which **branch on the build's own target** instead.

/// `open`'s access modes. POSIX fixes these three as values rather than bits.
@public O_RDONLY: c.int :: 0
@public O_WRONLY: c.int :: 1
@public O_RDWR:   c.int :: 2

// ===< The four flags the target decides >===
//
// Linux and the BSDs (macOS among them) chose different bits for these, and no
// arithmetic relates the two sets — `O_APPEND` is `0x400` on Linux and `0x8` on
// macOS. So each is read from `core/target`'s `OS`, which the compiler
// generated for this build: the branch is over a constant, so it folds, and an
// `#inline func` is what carries a `match` where a `::` wants an expression.
//
// They are functions rather than constants for that reason alone. `O_CREAT()`
// costs what `O_RDONLY` costs once the call is inlined and the arm is chosen.
//
// **This is what `#when` would replace.** With conditional compilation these
// would be four constants under two branches, and the file would not carry the
// other target's numbers at all. Until then this is the honest way to be right
// on both: `nestc` knows the target, so the library can ask it.

// Whether this target numbers its `open` flags the way the BSDs do.
bsd_flags :: #inline func () -> bool {
  return OS.match {
    .Macos   => true,
    .Freebsd => true,
    _        => false,
  }
}

/// Create the file if it does not exist.
@public O_CREAT :: #inline func () -> c.int {
  if bsd_flags() { return 512 }
  return 64
}

/// Truncate it to nothing if it does.
@public O_TRUNC :: #inline func () -> c.int {
  if bsd_flags() { return 1024 }
  return 512
}

/// Every write goes to the end, whatever the offset is.
@public O_APPEND :: #inline func () -> c.int {
  if bsd_flags() { return 8 }
  return 1024
}

/// Fail if the file already exists. With `O_CREAT`, this is how a file is
/// created *or* the attempt reported, with nothing in between.
@public O_EXCL :: #inline func () -> c.int {
  if bsd_flags() { return 2048 }
  return 128
}

/// `lseek` origins. POSIX fixes all three.
@public SEEK_SET: c.int :: 0
@public SEEK_CUR: c.int :: 1
@public SEEK_END: c.int :: 2

/// `access` modes.
@public F_OK: c.int :: 0
@public X_OK: c.int :: 1
@public W_OK: c.int :: 2
@public R_OK: c.int :: 4

/// The three descriptors every process starts with.
@public STDIN:  c.int :: 0
@public STDOUT: c.int :: 1
@public STDERR: c.int :: 2

/// The permission bits a created file and a created directory ask for, before
/// the process umask is applied: `0644` and `0755`, in decimal because the
/// language has no octal literal (§1.4).
@public MODE_FILE: c.uint :: 420
@public MODE_DIR:  c.uint :: 493

/// The `errno` values `std` reads by name rather than only reporting. All four
/// are the same number on Linux and on the BSDs.
@public ENOENT: c.int :: 2
@public EIO:    c.int :: 5
@public EINTR:  c.int :: 4
@public EEXIST: c.int :: 17
@public EISDIR: c.int :: 21

/// What `getcwd` answers when the buffer is too small for the path. Also the
/// same number on both.
@public ERANGE: c.int :: 34

// ===< Sockets >===
//
// What `std/net` is written on. The calls are POSIX's and the same everywhere;
// two things are not, and `#when` picks them per target: the numbers
// (`SOL_SOCKET` is `1` on Linux and `0xffff` on the BSDs) and the layout of
// `struct addrinfo`, whose `ai_addr` and `ai_canonname` swap places between
// Linux and the BSDs. A `struct sockaddr` is only ever handled as bytes (see
// `std/net`), which is what keeps its own difference — a length byte before the
// family on the BSDs — out of the declarations here.

extern("c") {
  @public socket      :: func (domain: c.int, kind: c.int, protocol: c.int) -> c.int
  @public setsockopt  :: func (fd: c.int, level: c.int, name: c.int, value: c.ptr.<c.int>, len: c.uint) -> c.int
  @public bind        :: func (fd: c.int, addr: c.ptr.<u8>, len: c.uint) -> c.int
  @public listen      :: func (fd: c.int, backlog: c.int) -> c.int
  @public accept      :: func (fd: c.int, addr: c.ptr.<u8>, len: c.ptr.<c.uint>) -> c.int
  @public connect     :: func (fd: c.int, addr: c.ptr.<u8>, len: c.uint) -> c.int
  @public getsockname :: func (fd: c.int, addr: c.ptr.<u8>, len: c.ptr.<c.uint>) -> c.int
  @public send        :: func (fd: c.int, buf: c.ptr.<c.uchar>, n: c.size_t, flags: c.int) -> c.ssize_t
  @public recv        :: func (fd: c.int, buf: c.ptr.<c.uchar>, n: c.size_t, flags: c.int) -> c.ssize_t
  @public shutdown    :: func (fd: c.int, how: c.int) -> c.int
  @public inet_ntop   :: func (family: c.int, src: c.ptr.<u8>, dst: c.ptr.<c.uchar>, size: c.uint) -> c.cstr

  /// Resolve `node` and `service` to a list of addresses, written to `res`; a
  /// non-zero answer is `getaddrinfo`'s own code, not an `errno`.
  @public getaddrinfo  :: func (node: c.cstr, service: c.cstr, hints: c.ptr.<AddrInfo>, res: c.ptr.<c.ptr.<AddrInfo>>) -> c.int
  @public freeaddrinfo :: func (list: c.ptr.<AddrInfo>) -> void
  @public gai_strerror :: func (code: c.int) -> c.cstr

  /// Wait until one of `fds` can be read or written, or `timeout` ms pass
  /// (`-1` waits for ever). `nfds_t` is an `unsigned int` on the BSDs and an
  /// `unsigned long` on Linux; a count passed as the wider one reads right on
  /// both, since it arrives in a register either way.
  @public poll :: func (fds: c.ptr.<PollFd>, n: c.ulong, timeout: c.int) -> c.int
}

/// One descriptor `poll` watches: what to watch it for, and what happened.
/// The same layout on every POSIX system.
@public(all) PollFd :: #repr("C") struct {
  fd: c.int,
  events: i16,
  revents: i16,
}

/// `poll`'s events: data to read (or a connection to accept), and the two it
/// reports without being asked — the other end hung up, or the descriptor
/// failed.
@public POLLIN: i16 :: 1
@public POLLERR: i16 :: 8
@public POLLHUP: i16 :: 16

/// One address `getaddrinfo` found, Linux's layout.
@public(all)
#when(os = .Linux)
AddrInfo :: #repr("C") struct {
  flags: c.int,
  family: c.int,
  socktype: c.int,
  protocol: c.int,
  addrlen: c.uint,
  addr: c.ptr.<u8>,
  canonname: c.cstr,
  next: c.ptr.<AddrInfo>,
}

/// One address `getaddrinfo` found, the BSDs' layout: `canonname` before `addr`.
@public(all)
#when(not(os = .Linux))
AddrInfo :: #repr("C") struct {
  flags: c.int,
  family: c.int,
  socktype: c.int,
  protocol: c.int,
  addrlen: c.uint,
  canonname: c.cstr,
  addr: c.ptr.<u8>,
  next: c.ptr.<AddrInfo>,
}

/// The families and the one socket type `std/net` uses.
@public AF_UNSPEC: c.int :: 0
@public AF_INET: c.int :: 2
@public SOCK_STREAM: c.int :: 1

/// IPv6's family: a number each system chose for itself.
@public
#when(os = .Linux)
AF_INET6: c.int :: 10
@public
#when(os = .Macos)
AF_INET6: c.int :: 30
@public
#when(not(any(os = .Linux, os = .Macos)))
AF_INET6: c.int :: 28

/// `getaddrinfo` for an address to bind to rather than to connect to.
@public AI_PASSIVE: c.int :: 1

/// `shutdown`'s directions.
@public SHUT_RD: c.int :: 0
@public SHUT_WR: c.int :: 1
@public SHUT_RDWR: c.int :: 2

/// The socket-level options.
@public
#when(os = .Linux)
SOL_SOCKET: c.int :: 1
@public
#when(not(os = .Linux))
SOL_SOCKET: c.int :: 65535

/// Let a server rebind its port at once after a restart.
@public
#when(os = .Linux)
SO_REUSEADDR: c.int :: 2
@public
#when(not(os = .Linux))
SO_REUSEADDR: c.int :: 4

/// A write to a peer that has gone away is an `EPIPE`, not a `SIGPIPE` that
/// stops the process. The BSDs set it on the socket; Linux passes
/// `MSG_NOSIGNAL` on each `send` instead, and has no such option.
@public
#when(not(os = .Linux))
SO_NOSIGPIPE: c.int :: 4130
@public
#when(os = .Linux)
MSG_NOSIGNAL: c.int :: 16384
@public
#when(not(os = .Linux))
MSG_NOSIGNAL: c.int :: 0

/// What a name that does not resolve is reported as: the address could not be
/// reached, which is what a caller can act on.
@public
#when(os = .Linux)
EHOSTUNREACH: c.int :: 113
@public
#when(not(os = .Linux))
EHOSTUNREACH: c.int :: 65
