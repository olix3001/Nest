// Other programs: running one, waiting for it, and ending this one.
//
// The arguments and the environment this process was started with are
// `<std/os/env>`'s.
//
// ### Spawning is `fork` and `exec`
//
// Not `posix_spawn`, whose `posix_spawn_file_actions_t` and `posix_spawnattr_t`
// are opaque structs whose *size* differs by platform — there is nothing to
// declare without `#when` or a shim. `fork` and `execvp` are two calls with
// integer arguments, which is a thing this language can say today.

c :: import <core/c>
io :: import "../io/io.nest"
sys :: import "sys.nest"
libc :: import "libc.nest"
{ transmute, make } :: import <core/mem>

// ===< Ending >===

/// Stop with this status, now.
///
/// Nothing is flushed on the way out, because `std/io` holds nothing back: a
/// `File` writes straight through to its descriptor. A buffered writer, when
/// there is one, will be the thing that has to be flushed before this is called
/// — by whoever made it.
@public exit :: func (status: i32) -> never { sys.exit(status) }

// ===< Running another program >===

/// How a process ended.
@public Status :: enum {
  // It returned this status from `main`, or passed it to `exit`.
  exited(i32),
  // It was killed by this signal. `9` is the one everybody knows.
  signalled(i32),
}

impl Status {
  /// Whether it ended the way a program that worked ends.
  @public ok :: func (self: Self) -> bool {
    return self.match { .exited(code) => code == 0, .signalled(_) => false }
  }

  /// The status to exit with when passing this one on: a signal has no status,
  /// so it becomes `128 + n`, which is what a shell reports.
  @public code :: func (self: Self) -> i32 {
    return self.match { .exited(code) => code, .signalled(n) => 128 + n }
  }
}

/// A process this one started, and has not yet waited for.
@public Child :: struct {
  pid: c.int,
}

impl Child {
  /// The process id, for a program calling something `std` does not wrap.
  @public pid_of :: #inline func (self: Self) -> c.int { return self.pid }

  /// Wait for it to end.
  ///
  /// The status word is decoded here rather than in `sys` because `WIFEXITED`
  /// and its friends are **macros**, so there is nothing to call: what they are
  /// macros over is the same arithmetic on every target this library names — the
  /// low seven bits are the signal that killed it, and the next eight are the
  /// status it exited with.
  @public wait :: func (self: Self) -> Result.<Status, io.Error> {
    let r: sys.Res := sys.wait(self.pid)
    if r.failed() { return .err(io.error_of("wait", "", r)) }
    let raw: i32 := cast.<i32>(r.n)
    let signal: i32 := raw % 128
    if signal == 0 { return .ok(.exited((raw / 256) % 256)) }
    return .ok(.signalled(signal))
  }
}

/// Start `program` with `args`, searching `PATH` for it.
///
/// `args` is what the program receives **after** its own name: `spawn("ls",
/// .{ "-l" })` runs `ls -l`, and `argv[0]` is filled in as `"ls"`. That is the
/// opposite of `execvp`'s own convention and the same as every other language's,
/// because the alternative is a list whose first element must be repeated.
///
/// **A failed `exec` ends the child**, with status 127 — the status a shell uses
/// for "command not found". It has to end: the child is a copy of this process,
/// and returning from here would run the rest of this program a second time.
@public spawn :: func (program: str, args: []str) -> Result.<Child, io.Error> {
  let argv: c.ptr.<c.cstr> := build_argv(program, args)
  let forked: sys.Res := sys.fork()
  if forked.failed() { return .err(io.error_of("spawn", program, forked)) }
  if forked.n == 0 {
    sys.exec(program, argv)
    sys.exit(127)
  }
  return .ok(Child { pid: cast.<c.int>(forked.n) })
}

/// What `output` answers: how the program ended, and everything it wrote to
/// stdout.
@public(all) Output :: struct {
  status: Status,
  stdout: []u8,
}

/// Run `program` with `args` and collect what it writes to **stdout**.
///
/// Its stderr is this process's, not captured: reading two pipes needs a way to
/// wait on both at once, or a program that fills one while this reads the other
/// blocks both forever. Stderr is where a program tells a person what went wrong,
/// and a person is still on the other end of this process's.
@public output :: func (program: str, args: []str) -> Result.<Output, io.Error> {
  let argv: c.ptr.<c.cstr> := build_argv(program, args)
  let p: sys.Res := sys.pipe()
  if p.failed() { return .err(io.error_of("spawn", program, p)) }
  let read_end: c.int := cast.<c.int>(p.n % 4294967296)
  let write_end: c.int := cast.<c.int>(p.n / 4294967296)

  let forked: sys.Res := sys.fork()
  if forked.failed() {
    close_quietly(read_end)
    close_quietly(write_end)
    return .err(io.error_of("spawn", program, forked))
  }
  if forked.n == 0 {
    if sys.dup2(write_end, libc.STDOUT).failed() { sys.exit(127) }
    close_quietly(read_end)
    close_quietly(write_end)
    sys.exec(program, argv)
    sys.exit(127)
  }

  // The parent's copy of the write end is closed **before** reading: the read
  // sees end of file only once every write end is gone, and this one would
  // never go.
  close_quietly(write_end)
  let child: Child := Child { pid: cast.<c.int>(forked.n) }
  let mut from: io.File := io.File.from_fd(read_end)
  let bytes: Result.<[]u8, io.Error> := io.read_to_end(&mut from)
  from.close().match { .ok(_) => (), .err(_) => () }
  let status: Status := child.wait().?
  return .ok(Output { status: status, stdout: bytes.? })
}

// Close a descriptor whose failure to close changes nothing: one end of a pipe
// on a path that is already failing, or in a child about to `exec`.
close_quietly :: func (fd: c.int) -> void {
  let closed: sys.Res := sys.close(fd)
}

/// Start it, wait for it, and answer how it ended.
@public run :: func (program: str, args: []str) -> Result.<Status, io.Error> {
  return spawn(program, args).?.wait()
}

// The `char **` `execvp` wants: the program's name, then the arguments, then a
// null pointer.
//
// It is built in **two passes** on purpose. The NUL-terminated copies come
// first, into a slice of byte slices the collector traces; only then is the
// table of addresses allocated and filled. Done the other way round, the table
// would be the only thing holding those copies — and it holds addresses, which
// are integers, which the collector does not follow (`core/c`). The last
// allocation before `exec` is the table itself, so nothing can be collected
// after the addresses are written.
build_argv :: func (program: str, args: []str) -> c.ptr.<c.cstr> {
  let n: usize := args.len() + 1
  let owned: []mut []u8 := make.<[][]u8>(n)
  owned[0] = nul_terminated(program)
  for i in 0..<args.len() { owned[i + 1] = nul_terminated(args[i]) }

  let table: []mut usize := make.<[]usize>(n + 1)
  for i in 0..<n { table[i] = transmute.<usize>(&owned[i][0]) }
  table[n] = 0
  return c.ptr.<c.cstr> { addr: transmute.<usize>(&table[0]) }
}

// `s`'s bytes with a NUL after them.
//
// It hands back an immutable view: the copy is finished, and `owned` below is a
// slice of `[]u8` because that is what a list of finished buffers is.
nul_terminated :: func (s: str) -> []u8 {
  let src: []u8 := s.as_bytes()
  let out: []mut u8 := make.<[]u8>(src.len() + 1)
  for i in 0..<src.len() { out[i] = src[i] }
  out[src.len()] = 0
  return cast.<[]u8>(out)
}
