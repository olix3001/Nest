// What this process was started with and where it stands: its arguments, its
// environment, and its working directory.
//
//     env :: import <std/os/env>
//
//     const home: Option.<str> := env.get("HOME")
//     for a in env.args() { ... }
//
// ### Where the arguments come from
//
// From the entry point, by way of the runtime. `main`'s `argc` / `argv` /
// `envp` are handed to `nest_init` and kept there
// (`nestc/src/lir/entry.rs`, `runtime/nest_runtime.c`), because the call to
// `main` is the **only** portable moment they exist: `environ` is not in the C
// standard, and on macOS a dynamic executable cannot link against it at all.
//
// The strings belong to the startup and live as long as the process, so a `str`
// cut out of one borrows rather than copies. That is why `args()` costs one
// allocation for the list and nothing per argument.

io :: import "../io/io.nest"
sys :: import "sys.nest"
libc :: import "libc.nest"
{ make } :: import <core/mem>

// ===< Arguments >===

// Every argument, `argv[0]` — the program's own name — first.
//
// One allocation, for the list. Each element points into the startup's own
// storage, which outlives the program.
@public args :: func () -> []str {
  let n: usize := sys.argc()
  let out: []mut str := make.<[]str>(n)
  for i in 0..<n { out[i] = sys.arg(i) }
  return cast.<[]str>(out)
}

// The name the program was invoked under, or `""` when there is no `argv[0]` —
// which a program started through a bare `execve` really can have.
@public program :: func () -> str {
  if sys.argc() == 0 { return "" }
  return sys.arg(0)
}

// ===< The environment >===

// The value of `name`, or `.none` when it is not set.
//
// An empty value and an unset name are **different**: `FOO=` sets `FOO` to the
// empty string, and this answers `.some("")` for it.
@public get :: func (name: str) -> Option.<str> { return sys.getenv(name) }

// Set `name` to `value` for this process and everything it spawns afterwards.
@public set :: func (name: str, value: str) -> Result.<void, io.Error> {
  let r: sys.Res := sys.setenv(name, value)
  if r.failed() { return .err(io.error_of("set environment", name, r)) }
  return .ok(())
}

// Unset `name`. Unsetting one that is not set is not an error.
@public unset :: func (name: str) -> Result.<void, io.Error> {
  let r: sys.Res := sys.unsetenv(name)
  if r.failed() { return .err(io.error_of("unset environment", name, r)) }
  return .ok(())
}

// One entry of the environment, already split.
@public(all) EnvVar :: struct {
  name: str,
  value: str,
}

// Every environment entry, in the order the operating system holds them.
//
// An entry with no `=` in it is skipped rather than reported: the table is the
// operating system's and a program reading it is not the right place to
// complain about its shape.
@public vars :: func () -> []EnvVar {
  // Counted first so the list is allocated once. Walking the table twice is
  // two scans of a few dozen pointers, which is cheaper than growing.
  let mut n: usize := 0
  while sys.env_at(n).match { .some(_) => true, .none => false } { n = n + 1 }

  let out: []mut EnvVar := make.<[]EnvVar>(n)
  let mut have: usize := 0
  for i in 0..<n {
    let entry: str := sys.env_at(i).match { .some(s) => s, .none => "" }
    let at: usize := index_of_eq(entry)
    if at < entry.len() {
      let raw: []u8 := entry.as_bytes()
      out[have] = EnvVar {
        name: cast.<str>(raw[0..<at]),
        value: cast.<str>(raw[at + 1..<raw.len()]),
      }
      have = have + 1
    }
  }
  return cast.<[]EnvVar>(out[0..<have])
}

// Where the first `=` is, or the length when there is none.
index_of_eq :: func (s: str) -> usize {
  let raw: []u8 := s.as_bytes()
  for i in 0..<raw.len() {
    if raw[i] == EQUALS { return i }
  }
  return raw.len()
}

EQUALS: u8 :: 61

// ===< Where it is >===

// The working directory, as an absolute path.
//
// `getcwd` wants a buffer and answers `ERANGE` when the path does not fit in
// it, so the buffer starts at a size most paths fit in and doubles until this
// one does.
@public current_dir :: func () -> Result.<str, io.Error> {
  let mut cap: usize := 256
  loop {
    let buf: []mut u8 := make.<[]u8>(cap)
    let r: sys.Res := sys.getcwd(buf)
    if r.failed() == false { return .ok(cast.<str>(buf[0..<cast.<usize>(r.n)])) }
    if r.err != libc.ERANGE { return .err(io.error_of("current directory", "", r)) }
    cap = cap * 2
  }
}
