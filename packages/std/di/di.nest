// Dependency injection, in .NET's shape: services are registered with a
// lifetime, a provider builds them on demand, and what a service needs is
// handed to it rather than looked up by it.
//
//     di :: import <std/di>
//     { inject } :: import <std/di>
//
//     Db :: struct { url: str }
//     Repo :: struct {
//         @inject db: *Db,   // filled from the provider
//         hits: i32,         // not injected: its `Default`, or zero
//     }
//
//     let mut services: di.Services := di.services()
//     services.add_singleton({ sp in Db { url: "app.db" } })
//     services.add_scoped_auto.<Repo>()
//     let root: *mut di.Scope := services.build()
//
//     let repo: *Repo := root.get.<Repo>().!
//     const n: i32 := root.invoke({ db: *Db, r: *Repo in r.hits }).!
//
// ### Pointers that read
//
// Services are handed out as `*T` — `get`, and a member or parameter written
// `*T` — because one service is shared by everything that asks for it, and a
// pointer that can write is a claim to be the only one doing so. `*mut T` is
// resolved too (`get_mut`, a `*mut T` member or parameter), for the code that
// really does own what it asks for, and a plain `T` is a **copy** of a scoped
// or transient service (`get_value`, a `T` member or parameter). A singleton is
// never copied: a copy would stop being the one everything shares.
//
// ### Built on reflection, not on the compiler
//
// Nothing here is special to the language. A registration is a closure stored
// as a `*dyn Func`, keyed by the service's `TypeId` (`core/reflect`). An
// **autowired** service (`add_*_auto`) is built by walking its members'
// descriptions: a member written `@inject` must be a pointer, and it is set to
// the service its pointee names; `invoke` does the same to a closure's
// parameters, building its `Args` tuple member by member and then making the
// call through `Func.call`.
//
// ### What a member that is not `@inject` gets
//
// Its type's `Default` when it has one, and zero otherwise — the value
// `mem.new` gives every member. A service that has to do more once its
// dependencies are in writes an `Init` impl, which runs last:
//
//     impl di.Init for Repo {
//         init :: func (self: *mut Repo, sp: *mut di.Scope) -> Result.<void, di.Error> {
//             self.hits = 100
//             return .ok(())
//         }
//     }
//
// ### Types that resolve themselves
//
// A type with a `Resolve` impl is not looked up: a parameter or `@inject`
// member of that type is built by its own `resolve`, from the scope. That is
// how a generic type is supplied — a request body decoded into any `T` —
// where a registration would have to name each `T`. It fails with a type of
// its own choosing (`Resolve.Failure`), which the provider does not interpret:
// the `Error` from `invoke` carries it, and `error.cause.<T>()` reads it back.
//
// ### Lifetimes
//
// A **singleton** is built once, by the root, and shared by every scope. A
// **scoped** service is built once per scope — `std/http` opens a scope per
// request. A **transient** one is built at every request for it. A singleton's
// own dependencies are resolved from the root, so a scoped service it asks for
// lives as long as the singleton does, the way .NET's root provider behaves.

collections :: import "../collections/collections.nest"
{ Vec, HashMap } :: import "../collections/collections.nest"
{ TypeId, Member, Kind, type_id, type_info, member_ptr, attr_of } :: import <core/reflect>
{ new, boxed, transmute, zeroed } :: import <core/mem>
{ Default } :: import <core/default>

/// Marks a member an autowired service gets from the provider: `*T` to read a
/// registered service `T`, `*mut T` to write it, or `T` for a copy of a scoped
/// or transient one.
@public(all) @attribute inject :: struct {}

/// How long a built service lives.
@public Lifetime :: enum {
    /// One for the whole provider.
    Singleton,
    /// One per scope.
    Scoped,
    /// A new one for every request.
    Transient,
}

/// What went wrong resolving a service: which one, and why.
@public(fields: package) Error :: struct {
    /// What went wrong, in words.
    @public message: str,
    // The failure a `Resolve` impl returned, of whatever type it chose; `.none`
    // for an error of the provider's own (a missing registration, a cycle).
    origin: Option.<Cause>,
}

// A value of any type, with the identity of that type.
Cause :: struct { id: u128, value: *mut void }

impl Error {
    /// The failure a `Resolve` impl returned, when it is a `T`. The provider
    /// does not look inside it; whoever called `invoke` knows what types its
    /// own `Resolve` impls fail with.
    @public cause :: func <T> (self: *Self) -> Option.<*T> {
        return self.origin.match {
            .some(c) => {
                if c.id == cast.<u128>(type_id.<T>()) { return .some(transmute.<*T>(c.value)) }
                return .none
            },
            .none => .none,
        }
    }
}

/// An `Error` saying `message`, with no cause.
@public fail :: func (message: str) -> Error {
    return Error { message: message, origin: .none }
}

/// The registrations a provider is built from.
@public(fields: package) Services :: struct {
    // Each registration's position in `entries`, by the `TypeId` of the service,
    // of a `*` to it and of a `*mut` to it — so a member or parameter typed as
    // either pointer finds it.
    index: HashMap.<u128, usize>,
    entries: Vec.<Entry>,
}

// One registration.
Entry :: struct {
    name: str,
    lifetime: Lifetime,
    make: *dyn Func(*mut Scope) -> Result.<*mut void, Error>,
}

/// No registrations yet.
@public services :: func () -> Services {
    return Services {
        index: collections.hash_map.new.<u128, usize>(),
        entries: collections.vec.new.<Entry>(),
    }
}

impl Services {
    /// A singleton `T`, made by `make` the first time anything asks for one.
    @public add_singleton :: func <T, F: Func(*mut Scope) -> T> (self: *mut Self, make: F) -> void {
        self.add.<T, F>(.Singleton, make)
    }

    /// A scoped `T`, made by `make` once per scope.
    @public add_scoped :: func <T, F: Func(*mut Scope) -> T> (self: *mut Self, make: F) -> void {
        self.add.<T, F>(.Scoped, make)
    }

    /// A transient `T`, made by `make` every time it is asked for.
    @public add_transient :: func <T, F: Func(*mut Scope) -> T> (self: *mut Self, make: F) -> void {
        self.add.<T, F>(.Transient, make)
    }

    /// `value`, as a singleton that is already built.
    @public add_instance :: func <T> (self: *mut Self, value: T) -> void {
        const made: *mut T := boxed(value)
        self.register.<T>(.Singleton, boxed({ sp: *mut Scope -> Result.<*mut void, Error> in
            .ok(transmute.<*mut void>(made))
        }))
    }

    /// A singleton `T`, autowired: its `@inject` members from the provider.
    @public add_singleton_auto :: func <T> (self: *mut Self) -> void {
        self.register.<T>(.Singleton, boxed({ sp: *mut Scope -> Result.<*mut void, Error> in autowire.<T>(sp) }))
    }

    /// A scoped `T`, autowired.
    @public add_scoped_auto :: func <T> (self: *mut Self) -> void {
        self.register.<T>(.Scoped, boxed({ sp: *mut Scope -> Result.<*mut void, Error> in autowire.<T>(sp) }))
    }

    /// A transient `T`, autowired.
    @public add_transient_auto :: func <T> (self: *mut Self) -> void {
        self.register.<T>(.Transient, boxed({ sp: *mut Scope -> Result.<*mut void, Error> in autowire.<T>(sp) }))
    }

    /// Whether a `T` is registered.
    @public has :: func <T> (self: *Self) -> bool {
        return self.index.get(cast.<u128>(type_id.<T>())).match { .some(_) => true, .none => false }
    }

    /// The root scope, which owns the singletons. The registrations are copied
    /// into it: registering more on `self` afterwards changes nothing it sees.
    @public build :: func (self: *Self) -> *mut Scope {
        const root: *mut Scope := new.<Scope>()
        root.* = Scope {
            services: boxed(self.*),
            root: root,
            cache: collections.hash_map.new.<usize, *mut void>(),
            provided: collections.hash_map.new.<u128, *mut void>(),
            resolving: collections.vec.new.<usize>(),
        }
        return root
    }

    add :: func <T, F: Func(*mut Scope) -> T> (self: *mut Self, lifetime: Lifetime, make: F) -> void {
        self.register.<T>(lifetime, boxed({ sp: *mut Scope -> Result.<*mut void, Error> in
            .ok(transmute.<*mut void>(boxed.<T>(make(sp))))
        }))
    }

    // The latest registration of a type wins, as it does in .NET.
    register :: func <T> (self: *mut Self, lifetime: Lifetime, make: *dyn Func(*mut Scope) -> Result.<*mut void, Error>) -> void {
        const at: usize := self.entries.len()
        self.entries.push(Entry { name: type_info.<T>().name, lifetime: lifetime, make: make })
        self.index.insert(cast.<u128>(type_id.<T>()), at).match { .some(_) => (), .none => () }
        self.index.insert(cast.<u128>(type_id.<*T>()), at).match { .some(_) => (), .none => () }
        self.index.insert(cast.<u128>(type_id.<*mut T>()), at).match { .some(_) => (), .none => () }
    }
}

/// Where services are resolved: the root one `Services.build` makes, or a child
/// of it (`scope()`) with scoped services of its own.
@public(fields: package) Scope :: struct {
    services: *Services,
    // The scope that owns the singletons; itself, for the root.
    root: *mut Scope,
    // What this scope has built, by registration.
    cache: HashMap.<usize, *mut void>,
    // What was handed to this scope ready-made (`provide`), by the `TypeId` of
    // the value, of a `*` and of a `*mut` to it — asked before any registration.
    provided: HashMap.<u128, *mut void>,
    // What is being built right now, innermost last, to report a cycle rather
    // than recurse until the stack runs out.
    resolving: Vec.<usize>,
}

impl Scope {
    /// The `T` this scope provides, to read. A singleton is shared by
    /// everything that asks for it, so what is handed out by default is a
    /// pointer that cannot write — `get_mut` is the deliberate other case.
    @public get :: func <T> (self: *mut Self) -> Result.<*T, Error> {
        const p: *mut void := self.resolve(cast.<u128>(type_id.<T>()), type_label.<T>()).?
        return .ok(transmute.<*T>(p))
    }

    /// The `T` this scope provides, to write: for a service the caller owns — a
    /// transient one, or a scoped one within its scope.
    @public get_mut :: func <T> (self: *mut Self) -> Result.<*mut T, Error> {
        const p: *mut void := self.resolve(cast.<u128>(type_id.<T>()), type_label.<T>()).?
        return .ok(transmute.<*mut T>(p))
    }

    /// Whether a `T` could be resolved here.
    @public has :: func <T> (self: *Self) -> bool {
        return self.services.has.<T>()
    }

    /// Make `value` what this scope answers for `T` (and for `*T`, `*mut T`),
    /// ahead of any registration: how a framework hands a handler the values
    /// that belong to one request — `std/http` provides its `Context`.
    @public provide :: func <T> (self: *mut Self, value: *mut T) -> void {
        const p: *mut void := transmute.<*mut void>(value)
        self.provided.insert(cast.<u128>(type_id.<T>()), p).match { .some(_) => (), .none => () }
        self.provided.insert(cast.<u128>(type_id.<*T>()), p).match { .some(_) => (), .none => () }
        self.provided.insert(cast.<u128>(type_id.<*mut T>()), p).match { .some(_) => (), .none => () }
    }

    /// A child scope: the same singletons, scoped services of its own.
    @public scope :: func (self: *mut Self) -> *mut Scope {
        const child: *mut Scope := new.<Scope>()
        child.* = Scope {
            services: self.services,
            root: self.root,
            cache: collections.hash_map.new.<usize, *mut void>(),
            provided: collections.hash_map.new.<u128, *mut void>(),
            resolving: collections.vec.new.<usize>(),
        }
        return child
    }

    /// The `T` this scope provides, **by value**: a copy of a scoped service or
    /// a new transient one. A singleton is refused — a copy of it would stop
    /// being the one everything else shares.
    @public get_value :: func <T> (self: *mut Self) -> Result.<T, Error> {
        const found: (*mut void, bool) := self.lookup(cast.<u128>(type_id.<T>()), type_label.<T>()).?
        if found.1 { return .err(by_value_singleton(type_info.<T>().name)) }
        return .ok(transmute.<*T>(found.0).*)
    }

    /// Call `f` with every parameter resolved from this scope:
    ///
    /// ```nest
    /// root.invoke({ db: *Db, log: *Log in log.write(db.url) }).!
    /// ```
    ///
    /// A parameter is a service the way an `@inject` member is: `*T` to read
    /// it, `*mut T` to write it, or `T` for a copy of a scoped or transient one.
    ///
    /// `R` is what `f` returns. It is inferred, or written to require one:
    /// `root.invoke.<i32>(f)` does not compile unless `f` returns an `i32`.
    @public invoke :: func <R, F: Func.<Output = R>> (self: *mut Self, f: F) -> Result.<R, Error> {
        // On the stack: an `invoke` per request must not allocate for the
        // arguments it only passes on.
        let args: F.Args := zeroed.<F.Args>()
        for m in type_info.<F.Args>().members {
            if not member_resolver.<F.Args>(&mut args, m).try_resolve(self).? {
                self.supply(member_ptr.<F.Args>(&mut args, m), m, "parameter").?
            }
        }
        return .ok(f.call(args))
    }

    /// Call `f` with its first parameters given and the rest resolved from this
    /// scope. `pre` is a tuple of the given ones, which `f`'s parameters start
    /// with — so a closure leaves their types out:
    ///
    /// ```nest
    /// root.invoke_with((ctx, 3)) { ctx, n, log: *Log in log.write(ctx.url, n) }.!
    /// ```
    ///
    /// The rest are services, exactly as `invoke`'s parameters are.
    @public invoke_with :: func <P, Rest, R, F: Func.<Args = (..P, ..Rest), Output = R>> (self: *mut Self, pre: P, f: F) -> Result.<R, Error> {
        let args: F.Args := zeroed.<F.Args>()
        const given: []Member := type_info.<P>().members
        const all: []Member := type_info.<F.Args>().members
        for i in 0..<all.len() {
            const into: *mut void := member_ptr.<F.Args>(&mut args, all[i])
            if i < given.len() {
                copy_bytes(into, member_ptr.<P>(&pre, given[i]), all[i].size)
            } else if not member_resolver.<F.Args>(&mut args, all[i]).try_resolve(self).? {
                self.supply(into, all[i], "parameter").?
            }
        }
        return .ok(f.call(args))
    }

    // Fill the slot `into` — a member or a parameter, described by `m` — with
    // the service it asks for: the address for a pointer, a copy for a value.
    supply :: func (self: *mut Self, into: *mut void, m: Member, what: str) -> Result.<void, Error> {
        return m.kind.match {
            .Ptr(pointee) => {
                const found: (*mut void, bool) := self.lookup(cast.<u128>(m.id), Label { what: "", name: pointee.name }).?
                transmute.<*mut *mut void>(into).* = found.0
                return .ok(())
            },
            _ => {
                const found: (*mut void, bool) := self.lookup(cast.<u128>(m.id), Label { what: what, name: m.name }).?
                if found.1 {
                    return .err(fail(f"{what} `{m.name}` takes a singleton by value; take a pointer to it"))
                }
                copy_bytes(into, found.0, m.size)
                return .ok(())
            },
        }
    }

    // The service registered under `key` and whether it is a singleton.
    lookup :: func (self: *mut Self, key: u128, name: Label) -> Result.<(*mut void, bool), Error> {
        const singleton: bool := self.services.index.get(key).match {
            .some(i) => self.services.entries.get(i).match {
                .some(e) => e.lifetime.match { .Singleton => true, _ => false },
                .none => false,
            },
            .none => false,
        }
        const p: *mut void := self.resolve(key, name).?
        const provided: bool := self.provided.get(key).match { .some(_) => true, .none => false }
        return .ok((p, singleton && provided == false))
    }

    // The service registered under `key`, built if this scope has not yet.
    resolve :: func (self: *mut Self, key: u128, name: Label) -> Result.<*mut void, Error> {
        self.provided.get(key).match {
            .some(p) => { return .ok(p) },
            .none => (),
        }
        const at: usize := self.services.index.get(key).match {
            .some(i) => i,
            .none => { return .err(fail(missing(name))) },
        }
        const e: Entry := self.services.entries.get(at).match {
            .some(e) => e,
            .none => { return .err(fail(missing(name))) },
        }
        return e.lifetime.match {
            .Singleton => self.root.build(at, e),
            .Scoped => self.build(at, e),
            .Transient => self.make(at, e),
        }
    }

    // `e`, cached in this scope.
    build :: func (self: *mut Self, at: usize, e: Entry) -> Result.<*mut void, Error> {
        const cached: Option.<*mut void> := self.cache.get(at)
        cached.match {
            .some(p) => { return .ok(p) },
            .none => (),
        }
        const p: *mut void := self.make(at, e).?
        self.cache.insert(at, p).match { .some(_) => (), .none => () }
        return .ok(p)
    }

    // `e`, built now, with a cycle reported rather than followed.
    make :: func (self: *mut Self, at: usize, e: Entry) -> Result.<*mut void, Error> {
        for r in self.root.resolving.iter() {
            if r == at { return .err(fail(f"`{e.name}` depends on itself")) }
        }
        self.root.resolving.push(at)
        const made: Result.<*mut void, Error> := e.make(self)
        self.root.resolving.pop().match { .some(_) => (), .none => () }
        return made
    }
}

// ===< Autowiring >===

/// What an autowired service does once its members are set: nothing, unless its
/// type says otherwise with an impl of its own — which is more specific than
/// this one, so it is the one that runs.
@public Init :: trait {
    init :: func (self: *mut Self, sp: *mut Scope) -> Result.<void, Error>
}

impl <T> Init for T {
    init :: func (self: *mut Self, sp: *mut Scope) -> Result.<void, Error> { return .ok(()) }
}

// A `T` with its `@inject` members resolved from `sp`, every other member its
// `Default` or zero, and then its `Init`.
autowire :: func <T> (sp: *mut Scope) -> Result.<*mut void, Error> {
    const v: *mut T := new.<T>()
    for m in type_info.<T>().members {
        attr_of.<inject>(m.attrs).match {
            .some(_) => {
                if not member_resolver.<T>(v, m).try_resolve(sp).? {
                    sp.supply(member_ptr.<T>(v, m), m, f"`@inject` member of `{type_info.<T>().name}`").?
                }
            },
            .none => member_fill.<T>(v, m).fill(),
        }
    }
    v.init(sp).?
    return .ok(transmute.<*mut void>(v))
}

// `n` bytes from `from` to `to`: a value whose type is known only by its
// description, copied the way `mem.copy` copies a typed one.
copy_bytes :: func (to: *mut void, from: *mut void, n: usize) -> void {
    const dst: []mut u8 := transmute.<[]mut u8>(Bytes { ptr: to, len: n })
    const src: []u8 := transmute.<[]u8>(Bytes { ptr: from, len: n })
    for i in 0..<n { dst[i] = src[i] }
}

// The two words a slice is, for `copy_bytes` to make one of.
Bytes :: struct { ptr: *mut void, len: usize }

// What asked for a service, for an error to name: a type (`what` empty), or a
// member or parameter by its name. Kept apart so a lookup that succeeds formats
// nothing.
Label :: struct { what: str, name: str }

type_label :: func <T> () -> Label {
    return Label { what: "", name: type_info.<T>().name }
}

missing :: func (l: Label) -> str {
    if l.what == "" {
        return f"no service `{l.name}` is registered"
    }
    return f"no service is registered for {l.what} `{l.name}`"
}

by_value_singleton :: func (name: str) -> Error {
    return fail(f"`{name}` is a singleton; take a pointer to it, not a copy")
}

/// A type that builds itself from a scope, rather than being registered: a
/// parameter or `@inject` member of this type is resolved by calling
/// `resolve` on it, before any registration is looked at. A generic type is
/// supplied this way — a decoded request body of whatever `T` is asked for —
/// where a registration would have to be written for each `T`.
///
/// It fails with a `Failure` of its own choosing. The provider does not look
/// inside it: the `Error` that comes back from `invoke` carries it as its
/// cause (`Error.cause.<T>()`), for the caller to read.
@public Resolve :: trait {
    Failure :: type
    resolve :: func (self: *mut Self, sp: *mut Scope) -> Result.<void, Self.Failure>
}

// Whether a member resolved itself: `false` for every type without a
// `Resolve` impl, and the impl's answer for one with — the bounded blanket
// impl is the more specific, so it is the one a `Resolve` type gets.
Resolver :: trait {
    try_resolve :: func (self: *Self, sp: *mut Scope) -> Result.<bool, Error>
}

impl <T> Resolver for T {
    try_resolve :: func (self: *Self, sp: *mut Scope) -> Result.<bool, Error> { return .ok(false) }
}

impl <T: Resolve> Resolver for T {
    try_resolve :: func (self: *Self, sp: *mut Scope) -> Result.<bool, Error> {
        return transmute.<*mut T>(self).resolve(sp).match {
            .ok(_) => .ok(true),
            .err(failure) => .err(Error {
                message: f"`{type_info.<T>().name}` could not resolve itself",
                origin: .some(Cause {
                    id: cast.<u128>(type_id.<T.Failure>()),
                    value: transmute.<*mut void>(boxed(failure)),
                }),
            }),
        }
    }
}

// Member `m` of `v`, as its own `Resolver` impl.
member_resolver :: #intrinsic("member_dyn") func <T> (v: *T, m: Member) -> *dyn Resolver

// Member `m` of `v`, as its own `Fill` impl.
member_fill :: #intrinsic("member_dyn") func <T> (v: *T, m: Member) -> *dyn Fill

// Put a member's starting value in place: its `Default`, when its type has one.
Fill :: trait {
    fill :: func (self: *Self) -> void
}

impl <T> Fill for T {
    fill :: func (self: *Self) -> void { }
}

impl <T: Default> Fill for T {
    fill :: func (self: *Self) -> void {
        const v: T := Default.default()
        transmute.<*mut T>(self).* = v
    }
}

tests :: #when(test) namespace {
    strs :: import "../text/str.nest"

    Clock :: struct { now: i32 }
    Db :: struct { url: str }
    Counter :: struct { n: i32 }
    impl Default for Counter { default :: func () -> Counter { return Counter { n: 7 } } }
    Repo :: struct {
        @inject db: *Db,
        @inject clock: *Clock,
        hits: Counter,
        ready: bool,
    }
    impl Init for Repo {
        init :: func (self: *mut Repo, sp: *mut Scope) -> Result.<void, Error> {
            self.ready = true
            return .ok(())
        }
    }
    Loop :: struct { @inject other: *Other }
    Other :: struct { @inject back: *Loop }
    Bad :: struct { @inject db: Db }

    setup :: func () -> *mut Scope {
        let mut s: Services := services()
        s.add_instance(Clock { now: 5 })
        s.add_singleton({ sp in Db { url: "app.db" } })
        s.add_scoped_auto.<Repo>()
        s.add_transient({ sp in Counter { n: 1 } })
        return s.build()
    }

    @test
    an_autowired_service_gets_its_dependencies :: func () -> Result.<void, Error> {
        const root := setup()
        const r: *Repo := root.get.<Repo>().?
        assert(r.db.url == "app.db")
        assert(r.clock.now == 5)
        assert(r.hits.n == 7, "a member that is not `@inject` gets its `Default`")
        assert(r.ready, "`Init` runs last")
        return .ok(())
    }

    @test
    lifetimes :: func () -> Result.<void, Error> {
        const root := setup()
        const a: *Repo := root.get.<Repo>().?
        const b: *Repo := root.get.<Repo>().?
        assert(a == b, "one scoped service per scope")
        const child := root.scope()
        const c: *Repo := child.get.<Repo>().?
        assert(a != c, "a new scope builds its own")
        assert(a.db == c.db, "and shares the singletons")
        const t1: *mut Counter := root.get_mut.<Counter>().?
        const t2: *mut Counter := root.get_mut.<Counter>().?
        assert(t1 != t2, "a transient service is built each time")
        return .ok(())
    }

    @test
    invoke_resolves_parameters :: func () -> Result.<void, Error> {
        const root := setup()
        const n: i32 := root.invoke({ c: *Clock, r: *Repo in c.now + r.hits.n }).?
        assert(n == 12)
        const m := root.invoke.<i32>({ c: *Clock in c.now })
        assert(m.match { .ok(v) => v == 5, .err(_) => false }, "`R` written")
        return .ok(())
    }

    // Resolves itself from what the scope holds, as `std/http`'s `Json` does.
    Doubled :: struct { n: i32 }
    NoTime :: struct { at: i32 }
    impl Resolve for Doubled {
        Failure :: NoTime
        resolve :: func (self: *mut Doubled, sp: *mut Scope) -> Result.<void, NoTime> {
            const c: *Clock := sp.get.<Clock>().match {
                .ok(c) => c,
                .err(_) => { return .err(NoTime { at: 0 }) },
            }
            if c.now < 0 { return .err(NoTime { at: c.now }) }
            self.n = c.now * 2
            return .ok(())
        }
    }
    Uses :: struct { @inject d: Doubled }

    @test
    a_type_can_resolve_itself :: func () -> Result.<void, Error> {
        let mut s: Services := services()
        s.add_instance(Clock { now: 5 })
        s.add_scoped_auto.<Uses>()
        const root := s.build()
        const n: i32 := root.invoke({ d: Doubled, c: *Clock in d.n + c.now }).?
        assert(n == 15, "a parameter")
        const u: *Uses := root.get.<Uses>().?
        assert(u.d.n == 10, "an `@inject` member")

        let mut bad: Services := services()
        bad.add_instance(Clock { now: -1 })
        const failed := bad.build().invoke({ d: Doubled in d.n })
        const why: Option.<i32> := failed.match {
            .ok(_) => .none,
            .err(e) => e.cause.<NoTime>().match { .some(t) => .some(t.at), .none => .none },
        }
        assert(why.match { .some(at) => at == -1, .none => false }, "its failure is the error's cause")
        return .ok(())
    }

    @test
    invoke_with_takes_leading_arguments :: func () -> Result.<void, Error> {
        const root := setup()
        const one: i32 := root.invoke_with((10,)) { base, c: *Clock in base + c.now }.?
        assert(one == 15, "one given, one resolved")
        const two: i32 := root.invoke_with((1, 2)) { a, b, c: *Clock, r: *Repo in a + b + c.now + r.hits.n }.?
        assert(two == 15, "two given, two resolved")
        const none: i32 := root.invoke_with((3, 4)) { a, b in a * b }.?
        assert(none == 12, "nothing resolved")
        return .ok(())
    }

    Stamp :: struct { n: i32 }
    Holder :: struct {
        @inject stamp: Stamp,
        @inject counter: Counter,
    }
    Greedy :: struct { @inject db: Db }

    @test
    services_are_copied_by_value :: func () -> Result.<void, Error> {
        let mut s: Services := services()
        s.add_scoped({ sp in Stamp { n: 3 } })
        s.add_transient({ sp in Counter { n: 4 } })
        s.add_singleton({ sp in Db { url: "x" } })
        s.add_scoped_auto.<Holder>()
        s.add_scoped_auto.<Greedy>()
        const root := s.build()
        const h: *Holder := root.get.<Holder>().?
        assert(h.stamp.n == 3 && h.counter.n == 4, "a `T` member is a copy")
        const st: Stamp := root.get_value.<Stamp>().?
        assert(st.n == 3)
        const sum: i32 := root.invoke({ a: Stamp, b: *Counter in a.n + b.n }).?
        assert(sum == 7, "a `T` parameter too")
        assert(root.get_value.<Db>().match { .ok(_) => false, .err(_) => true }, "a singleton is not copied")
        assert(root.get.<Greedy>().match { .ok(_) => false, .err(_) => true })
        return .ok(())
    }

    @test
    failures_are_reported :: func () {
        let mut s: Services := services()
        s.add_scoped_auto.<Loop>()
        s.add_scoped_auto.<Other>()
        s.add_scoped_auto.<Bad>()
        const root := s.build()
        assert(root.get.<Clock>().match { .ok(_) => false, .err(e) => strs.ends_with(e.message, "Clock` is registered") })
        assert(root.get.<Loop>().match { .ok(_) => false, .err(e) => strs.ends_with(e.message, "Loop` depends on itself") })
        assert(root.get.<Bad>().match { .ok(_) => false, .err(_) => true })
        const missing := root.invoke({ c: *Clock, s: Stamp in c.now + s.n })
        assert(missing.match { .ok(_) => false, .err(e) => strs.ends_with(e.message, "Clock` is registered") })
        const by_value := root.invoke({ s: Stamp in s.n })
        assert(by_value.match { .ok(_) => false, .err(e) => strs.ends_with(e.message, "for parameter `0`") })
    }
}
