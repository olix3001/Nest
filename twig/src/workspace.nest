// The packages a build involves: the one being built, and everything it depends
// on, directly or not.
//
// ### One package per name
//
// Each package is compiled once, into `build/<profile>/deps/<name>.nlib`, and
// every package that depends on it is compiled against that one file. So the
// graph is **flat**: two dependencies that both depend on `util` must mean the
// same `util` — the same directory — and two different directories claiming one
// name is an error here rather than a question for the compiler.
//
// ### Direct and indirect
//
// A package may import what it depends on directly, and nothing else. What its
// dependencies depend on is still handed to `nestc`, to be loaded and linked,
// but as `--indirect` rather than `--extern`.

fs :: import <std/fs>
s :: import <std/str>
collections :: import <std/collections>
{ Vec } :: import <std/collections>
path :: import <std/path>
manifest :: import "manifest.nest"
{ Manifest } :: import "manifest.nest"
toolchain :: import "toolchain.nest"
{ Shipped } :: import "toolchain.nest"

// A package, where it is, and what its manifest says.
@public Member :: struct {
  name: str,
  // Absolute and normalized, which is what makes two of them comparable.
  dir: str,
  manifest: Manifest,
}

impl Member {
  // The file `nestc` should be given as this package's root.
  @public lib_root :: func (self: *Self) -> Option.<str> {
    return self.manifest.lib.match {
      .some(l) => .some(path.normalize(path.join(self.dir, l.path))),
      .none => .none,
    }
  }
}

@public Workspace :: struct {
  root: Member,
  // Every other package in the graph, the ones that ship with the compiler
  // included, each after every package it depends on.
  deps: []Member,
  // The names of the packages that ship with the compiler, in the order it
  // reports them, and stopping before the root when it is one of them: building
  // `std` builds that `std` against `core`, not against the compiler's `std`.
  shipped: []str,
}

impl Workspace {
  // The package called `name`, which is in the graph.
  @public member :: func (self: *Self, name: str) -> Member {
    if name == self.root.name { return self.root }
    return find(self.deps, name).!
  }

  // What `m` depends on directly, and so may import: the shipped packages it
  // does not come before, then its `[dependencies]`.
  //
  // The compiler reports its packages in the order they depend on each other,
  // so a shipped package depends on the ones before it, and any other package
  // depends on all of them.
  @public direct :: func (self: *Self, m: *Member) -> []str {
    let mut out: Vec.<str> := collections.new.<str>()
    for name in self.shipped {
      if name == m.name { break }
      out.push(name)
    }
    out.extend(m.manifest.dependency_names())
    return out.as_slice()
  }

  // What the packages in `direct` depend on, directly or not, that is not in
  // `direct` itself.
  @public indirect :: func (self: *Self, direct: []str) -> []str {
    let mut seen: Vec.<str> := collections.from_slice.<str>(direct)
    let mut out: Vec.<str> := collections.new.<str>()
    // `seen` is the queue as well as the answer.
    let mut next: usize := 0
    while next < seen.len() {
      let m: Member := self.member(seen.get(next).!)
      next = next + 1
      for name in self.direct(&m) {
        if contains(seen.as_slice(), name) { continue }
        seen.push(name)
        out.push(name)
      }
    }
    return manifest.sorted(out.as_slice())
  }
}

// The directory holding the manifest `start` is under: `start` itself, or the
// nearest parent with a `nest.toml` in it.
@public find_root :: func (start: str) -> Result.<str, str> {
  let mut dir: str := path.normalize(start)
  loop {
    if fs.exists(path.join(dir, manifest.FILE_NAME)) { return .ok(dir) }
    if dir == "/" || dir == "." {
      return .err(f"could not find `{manifest.FILE_NAME}` in `{start}` or any parent directory")
    }
    dir = path.parent(dir)
  }
}

// The package in `root_dir` and everything it reaches.
@public resolve :: func (root_dir: str) -> Result.<Workspace, str> {
  let root: Member := member(root_dir, manifest.load(root_dir).?)
  let ships: []Shipped := toolchain.packages().?
  let mut all: Vec.<Member> := collections.new.<Member>()
  all.push(root)

  // Breadth first; `all` is the queue as well as the answer.
  let mut next: usize := 0
  while next < all.len() {
    let from: Member := all.get(next).!
    next = next + 1
    for name in from.manifest.dependency_names() {
      let rel: str := from.manifest.dependency(name).path.!
      let dir: str := path.normalize(path.join(from.dir, rel))
      let seen: Option.<Member> := find(all.as_slice(), name)
      let again: bool := seen.match {
        .some(m) => {
          if m.dir != dir {
            return .err(f"two packages are named `{name}`: `{m.dir}` and `{dir}` (from `{from.name}`)")
          }
          true
        },
        .none => false,
      }
      if again { continue }

      let m: Manifest := manifest.load(dir).match {
        .ok(m) => m,
        .err(why) => { return .err(f"dependency `{name}` of `{from.name}`: {why}") },
      }
      if m.package.name != name {
        return .err(f"`{from.name}` depends on `{name}`, but the package at `{dir}` is `{m.package.name}`")
      }
      let has_lib: bool := m.lib.match { .some(_) => true, .none => false }
      if has_lib == false {
        return .err(f"`{from.name}` depends on `{name}`, which has no `[lib]`")
      }
      all.push(member(dir, m))
    }
  }

  let mut names: Vec.<str> := collections.new.<str>()
  for p in ships {
    if p.name == root.name { break }
    all.push(shipped(p).?)
    names.push(p.name)
  }

  let unordered: []Member := all.as_slice()[1..<all.len()]
  let ws: Workspace := Workspace { root: root, deps: unordered, shipped: names.as_slice() }
  let mut visiting: Vec.<str> := collections.new.<str>()
  let mut done: Vec.<Member> := collections.new.<Member>()
  order(&ws, root.name, &mut visiting, &mut done).?
  // The root is the last thing finished; everything before it is a dependency.
  let deps: []Member := done.as_slice()[0..<done.len() - 1]
  return .ok(Workspace { root: root, deps: deps, shipped: ws.shipped })
}

// Put `name` in `done` after everything it depends on, depth first. `visiting`
// is the path from the root to `name`, which is a cycle when `name` is on it.
order :: func (ws: *Workspace, name: str, visiting: *mut Vec.<str>, done: *mut Vec.<Member>) -> Result.<void, str> {
  let finished: bool := find(done.as_slice(), name).match { .some(_) => true, .none => false }
  if finished { return .ok(()) }
  let path_so_far: []str := visiting.as_slice()
  for i in 0..<path_so_far.len() {
    if path_so_far[i] == name {
      let cycle: str := s.join(path_so_far[i..<path_so_far.len()], "` -> `")
      return .err(f"packages depend on each other in a cycle: `{cycle}` -> `{name}`")
    }
  }
  visiting.push(name)
  let m: Member := ws.member(name)
  for d in ws.direct(&m) { order(ws, d, visiting, done).? }
  let left: str := visiting.pop().!
  done.push(m)
  return .ok(())
}

// A package that ships with the compiler, read from the manifest beside its root.
shipped :: func (p: Shipped) -> Result.<Member, str> {
  let dir: str := path.parent(p.root)
  let m: Manifest := manifest.load(dir).match {
    .ok(m) => m,
    .err(why) => { return .err(f"`{p.name}`, which ships with the compiler: {why}") },
  }
  if m.package.name != p.name {
    return .err(f"the compiler ships `{p.name}` at `{dir}`, but the package there is `{m.package.name}`")
  }
  return .ok(member(dir, m))
}

member :: func (dir: str, m: Manifest) -> Member {
  return Member { name: m.package.name, dir: dir, manifest: m }
}

find :: func (members: []Member, name: str) -> Option.<Member> {
  for m in members {
    if m.name == name { return .some(m) }
  }
  return .none
}

contains :: func (names: []str, name: str) -> bool {
  for n in names {
    if n == name { return true }
  }
  return false
}

// Public because the fixtures are what a test of the build plan in `main.nest`
// builds its workspace with: one graph, described in one place.
@public tests :: namespace {
    @public member_of :: func (name: str, deps: []str) -> Member {
        let mut d: collections.HashMap.<str, manifest.Dependency> :=
            collections.map.<str, manifest.Dependency>()
        for n in deps { d.insert(n, manifest.Dependency { path: .some(f"../{n}") }) }
        return Member {
            name: name,
            dir: f"/w/{name}",
            manifest: Manifest {
                package: manifest.Package { name: name, version: "0.1.0" },
                lib: .some(manifest.Lib { path: "src/package.nest" }),
                bin: .none,
                dependencies: .some(d),
                profile: .none,
                build: .none,
            },
        }
    }

    // `app` depends on `util`, `util` on `tiny`, and both ship packages are
    // before all of them.
    @public graph :: func () -> Workspace {
        return Workspace {
            root: member_of("app", .{ "util" }),
            deps: .{
                member_of("core", .{}),
                member_of("std", .{}),
                member_of("tiny", .{}),
                member_of("util", .{ "tiny" }),
            },
            shipped: .{ "core", "std" },
        }
    }

    @test
    direct_is_the_shipped_packages_then_the_dependencies :: func () {
        let ws: Workspace := graph()
        let app: []str := ws.direct(&ws.root)
        assert(app.len() == 3)
        assert(app[0] == "core")
        assert(app[1] == "std")
        assert(app[2] == "util")
        // A shipped package does not depend on itself or on what comes after
        // it: `std` sees `core`, and `core` sees nothing.
        let std: Member := ws.member("std")
        assert(ws.direct(&std).len() == 1)
        assert(ws.direct(&std)[0] == "core")
        let core: Member := ws.member("core")
        assert(ws.direct(&core).len() == 0)
    }

    // What a package's dependencies depend on is linked but not importable.
    @test
    indirect_is_what_the_direct_ones_reach :: func () {
        let ws: Workspace := graph()
        let rest: []str := ws.indirect(ws.direct(&ws.root))
        assert(rest.len() == 1)
        assert(rest[0] == "tiny")
        // With `tiny` named directly there is nothing left over.
        assert(ws.indirect(.{ "core", "std", "tiny", "util" }).len() == 0)
    }

    @test
    a_member_is_found_by_name :: func () {
        let ws: Workspace := graph()
        assert(ws.member("app").dir == "/w/app", "the root answers to its own name")
        assert(ws.member("tiny").dir == "/w/tiny")
    }
}
