// twig: builds Nest packages.
//
// The command line is read by hand. It is small, and a second program that
// needs the same parsing is what would earn a parser a place in `std`.

io :: import <std/io>
fs :: import <std/fs>
s :: import <std/text/str>
process :: import <std/os/process>
env :: import <std/os/env>
collections :: import <std/collections>
{ Vec } :: import <std/collections>
{ String } :: import <std/text/string>
path :: import <std/fs/path>
build :: import "build.nest"
{ Profile, Target } :: import "build.nest"
workspace :: import "workspace.nest"
{ Workspace, Member } :: import "workspace.nest"
metadata :: import "metadata.nest"
new :: import "new.nest"
term :: import "term.nest"

usage :: func () -> str {
  return s.join(.{
    "usage: twig <command> [options]",
    "",
    "commands:",
    "  new <path>       create a package in a new directory",
    "  init             create a package in the current directory",
    "  build            compile the package's targets",
    "  run [-- <args>]  build a binary, then run it with <args>",
    "  test [filter]    build the package's `@test` functions and run them —",
    "                   the ones beside its code, then each file in tests/",
    "                   against its library. With a filter, only the tests",
    "                   whose names contain it",
    "  metadata         how each package is compiled, as JSON, for tools",
    "",
    "options:",
    "  --release        build with the release profile (default: debug)",
    "  --bin <name>     build or run only this binary",
    "  --deps           build: only the libraries the package depends on",
    "  -v, --verbose    print each compiler command before running it",
    "  --emit <list>    build, run: also write the compiler's dumps for the",
    "                   package's own targets beside their objects, in",
    "                   build/<profile>/obj: ast, ir, mono, lir, llvm-ir, asm",
    "  --build-dir <dir>  build, run, test, metadata: where the build writes,",
    "                   instead of the package's own build/. Everything goes",
    "                   there, this package's targets and its dependencies'",
    "  --nestc-arg <arg>  build, run, test: one more argument for `nestc`, last",
    "                   on the command line and on the package's own targets",
    "                   only. Repeatable. `[build]` in nest.toml is the same",
    "                   thing written down",
    "  --lib            new, init: a library rather than a binary",
    "  -h, --help       this",
    "",
  }, "\n")
}

Options :: struct {
  command: str,
  release: bool,
  verbose: bool,
  bin: Option.<str>,
  lib: bool,
  deps: bool,
  emit: Vec.<str>,
  // `--build-dir`: where the build writes, instead of the root package's own
  // `build/`.
  build_dir: Option.<str>,
  // `--nestc-arg`: passed to the compiler verbatim, in order.
  nestc_args: Vec.<str>,
  positional: Vec.<str>,
  // Everything after `--`, for `run` to pass on.
  rest: []str,
}

main :: func () -> i32 {
  let opts: Options := parse(env.args()).match {
    .ok(o) => o,
    .err(why) => {
      term.error(why)
      io.eprint(usage())
      return 2
    },
  }
  let done: Result.<i32, str> := opts.command.match {
    "help" => run_help(),
    "new" => run_new(&opts),
    "init" => run_init(&opts),
    "build" => run_build(&opts),
    "run" => run_run(&opts),
    "test" => run_test(&opts),
    "metadata" => run_metadata(&opts),
    _ => .err(f"no command `{opts.command}`; see `twig --help`"),
  }
  return done.match {
    .ok(code) => code,
    .err(why) => {
      term.error(why)
      1
    },
  }
}

run_help :: func () -> Result.<i32, str> {
  io.print(usage())
  return .ok(0)
}

parse :: func (args: []str) -> Result.<Options, str> {
  let mut o: Options := Options {
    command: "",
    release: false,
    verbose: false,
    bin: .none,
    lib: false,
    deps: false,
    emit: collections.vec.new.<str>(),
    build_dir: .none,
    nestc_args: collections.vec.new.<str>(),
    positional: collections.vec.new.<str>(),
    rest: args[args.len()..<args.len()],
  }
  let mut i: usize := 1
  while i < args.len() {
    let a: str := args[i]
    if a == "--" {
      o.rest = args[i + 1..<args.len()]
      break
    } else if a == "-h" || a == "--help" {
      o.command = "help"
      return .ok(o)
    } else if a == "--release" {
      o.release = true
    } else if a == "-v" || a == "--verbose" {
      o.verbose = true
    } else if a == "--lib" {
      o.lib = true
    } else if a == "--deps" {
      o.deps = true
    } else if a == "--emit" {
      if i + 1 == args.len() { return .err("`--emit` needs a list") }
      for e in s.split(args[i + 1], ",") {
        if e.len() == 0 { continue }
        if build.known_emit(e) == false {
          return .err(f"`--emit` does not know `{e}`; it takes {build.EMITS}")
        }
        o.emit.push(e)
      }
      i = i + 1
    } else if a == "--build-dir" {
      if i + 1 == args.len() { return .err("`--build-dir` needs a path") }
      o.build_dir = .some(args[i + 1])
      i = i + 1
    } else if a == "--nestc-arg" {
      if i + 1 == args.len() { return .err("`--nestc-arg` needs an argument") }
      o.nestc_args.push(args[i + 1])
      i = i + 1
    } else if a == "--bin" {
      if i + 1 == args.len() { return .err("`--bin` needs a name") }
      o.bin = .some(args[i + 1])
      i = i + 1
    } else if a.len() > 0 && a.as_bytes()[0] == 45 {
      return .err(f"no option `{a}`")
    } else if o.command == "" {
      o.command = a
    } else {
      o.positional.push(a)
    }
    i = i + 1
  }
  if o.command == "" { o.command = "help" }
  return .ok(o)
}

cwd :: func () -> Result.<str, str> {
  return env.current_dir().match {
    .ok(d) => .ok(d),
    .err(e) => .err(e.describe()),
  }
}

// `--build-dir` as an absolute path: a relative one is read from the directory
// the command was run in, like every other path twig is given.
build_dir :: func (o: *Options) -> Result.<Option.<str>, str> {
  return o.build_dir.match {
    .some(d) => .ok(.some(path.normalize(path.join(cwd().?, d)))),
    .none => .ok(.none),
  }
}

run_new :: func (o: *Options) -> Result.<i32, str> {
  if o.positional.len() != 1 { return .err("`twig new` takes one path") }
  let given: str := o.positional.get(0).!
  let dir: str := path.normalize(path.join(cwd().?, given))
  let name: str := path.file_name(dir)
  if fs.exists(dir) { return .err(f"`{given}` already exists") }
  new.create(dir, name, o.lib).?
  term.status("Created", f"{kind(o.lib)} `{name}`")
  return .ok(0)
}

run_init :: func (o: *Options) -> Result.<i32, str> {
  if o.positional.len() != 0 { return .err("`twig init` takes no path; it uses the current directory") }
  let dir: str := cwd().?
  let name: str := path.file_name(dir)
  new.create(dir, name, o.lib).?
  term.status("Created", f"{kind(o.lib)} `{name}`")
  return .ok(0)
}

kind :: func (lib: bool) -> str { return if lib { "library" } else { "binary" } }

// The workspace the current directory is in.
open :: func () -> Result.<Workspace, str> {
  let root: str := workspace.find_root(cwd().?).?
  return workspace.resolve(root)
}

run_build :: func (o: *Options) -> Result.<i32, str> {
  if o.positional.len() != 0 { return .err("`twig build` takes no arguments") }
  let ws: Workspace := open().?
  let mut p: Profile := build.profile(&ws.root.manifest, o.release)
  p.emit = o.emit.as_slice()
  p.nestc_args = o.nestc_args.as_slice()
  p.verbose = o.verbose
  p.build_dir = build_dir(o).?
  if o.deps {
    compile_deps(&ws, p).?
    return .ok(0)
  }
  let all: []Target := build.binaries(&ws)
  let chosen: []Target := o.bin.match {
    .some(name) => select(all, name).?,
    .none => all,
  }
  compile_all(&ws, p, chosen).?
  return .ok(0)
}

run_run :: func (o: *Options) -> Result.<i32, str> {
  if o.positional.len() != 0 { return .err("arguments for the program go after `--`") }
  let ws: Workspace := open().?
  let mut p: Profile := build.profile(&ws.root.manifest, o.release)
  p.emit = o.emit.as_slice()
  p.nestc_args = o.nestc_args.as_slice()
  p.verbose = o.verbose
  p.build_dir = build_dir(o).?
  let bins: []Target := build.binaries(&ws)
  let t: Target := o.bin.match {
    .some(name) => select(bins, name).?[0],
    .none => {
      if bins.len() == 0 { return .err(f"`{ws.root.name}` has no `[[bin]]` to run") }
      if bins.len() > 1 { return .err(f"`{ws.root.name}` has several binaries; say which with `--bin`") }
      bins[0]
    },
  }
  let one: Vec.<Target> := collections.vec.from_slice.<Target>(.{ t })
  compile_all(&ws, p, one.as_slice()).?

  let exe: str := build.output(&ws, p, t)
  term.status("Running", f"`{shown(&ws, exe)}`")
  let status: process.Status := process.run(exe, o.rest).match {
    .ok(s) => s,
    .err(e) => { return .err(f"could not run `{exe}`: {e.describe()}") },
  }
  return .ok(status.code())
}

// Build the package's tests and run them.
//
// The test binary is not one of the package's targets: it is the same entry
// compiled a second way (`build.tests`), so what is built here is the
// dependencies and then it — the root's own `.nlib` is not in the way, because
// the tests are compiled *as* the package rather than against it.
//
// Then the **integration tests**: each file in the package's `tests/` is a
// program of its own, compiled with `--test` against the package's library —
// so it sees only what the library makes `@public`, which is the point of
// writing a test there rather than beside the code.
//
// A filter is handed to every test binary through `NEST_TEST_FILTER`, which the
// runner in `core` reads; the binaries' own arguments are not the runner's.
run_test :: func (o: *Options) -> Result.<i32, str> {
  if o.positional.len() > 1 { return .err("`twig test` takes at most one filter; arguments for the test binary go after `--`") }
  if o.positional.len() == 1 {
    env.set("NEST_TEST_FILTER", o.positional.as_slice()[0]).match {
      .ok(_) => (),
      .err(e) => { return .err(e.describe()) },
    }
  }
  let ws: Workspace := open().?
  let mut p: Profile := build.profile(&ws.root.manifest, o.release)
  p.emit = o.emit.as_slice()
  p.nestc_args = o.nestc_args.as_slice()
  p.verbose = o.verbose
  p.build_dir = build_dir(o).?
  let t: Target := build.test_target(&ws).?
  let integration: []Target := build.integration_targets(&ws).?
  // The integration tests import the package's library, so it is compiled
  // too when there are any.
  let libs: []Target := plan(&ws, p, integration.len() > 0).?
  let total: usize := libs.len() + 1 + integration.len()
  let mut n: usize := compile_each(&ws, p, libs, 0, total).?
  n = n + 1
  compiling(&ws.root, n, total)
  build.compile(&ws, p, t).?
  for it in integration {
    n = n + 1
    compiling(&ws.root, n, total)
    build.compile(&ws, p, it).?
  }

  let mut worst: i32 := run_one(&ws, p, t, o.rest).?
  for it in integration {
    const code: i32 := run_one(&ws, p, it, o.rest).?
    if worst == 0 { worst = code }
  }
  return .ok(worst)
}

// Run one test binary, and answer its status.
run_one :: func (ws: *Workspace, p: Profile, t: Target, args: []str) -> Result.<i32, str> {
  let exe: str := build.output(ws, p, t)
  term.status("Running", f"`{shown(ws, exe)}`")
  let status: process.Status := process.run(exe, args).match {
    .ok(s) => s,
    .err(e) => { return .err(f"could not run `{exe}`: {e.describe()}") },
  }
  return .ok(status.code())
}

// Every library that is out of date, in order, then `bins`.
compile_all :: func (ws: *Workspace, p: Profile, bins: []Target) -> Result.<void, str> {
  let libs: []Target := plan(ws, p, true).?
  let root_done: bool := names(libs, ws.root.name)
  // What the counter counts is the lines this run will print: one per library
  // it compiles, and one for the root package when a binary is built from it.
  let extra: usize := if bins.len() > 0 && root_done == false { 1 } else { 0 }
  let total: usize := libs.len() + extra
  let mut n: usize := compile_each(ws, p, libs, 0, total).?
  if extra == 1 {
    n = n + 1
    compiling(&ws.root, n, total)
  }
  for t in bins { build.compile(ws, p, t).? }
  term.status("Finished", f"`{p.name}` profile, in `{shown(ws, build.out_dir(ws, p))}`")
  return .ok(())
}

// Compile `targets` in order, numbering each line from `from` out of `total`,
// and answer how many lines have been printed once they are done.
compile_each :: func (ws: *Workspace, p: Profile, targets: []Target, from: usize, total: usize) -> Result.<usize, str> {
  let mut n: usize := from
  for t in targets {
    n = n + 1
    let m: Member := ws.member(t.name)
    compiling(&m, n, total)
    build.compile(ws, p, t).?
  }
  return .ok(n)
}

// The libraries a build has to compile, in order, decided **before** any of them
// is: that is what lets each line say which of how many it is.
//
// A library is compiled when its own inputs changed — which `nestc --up-to-date`
// answers — or when anything it depends on is being compiled again, because the
// library it would be compiled against is then not the one on disk. The second
// rule is what makes one pass enough: the packages come in dependency order, so
// a dependency is already decided when the package that needs it is reached, and
// asking the compiler about it would only be asking about a stale file.
plan :: func (ws: *Workspace, p: Profile, with_root: bool) -> Result.<[]Target, str> {
  let mut out: Vec.<Target> := collections.vec.new.<Target>()
  let mut again: Vec.<str> := collections.vec.new.<str>()
  for t in build.libraries(ws) {
    if with_root == false && t.name == ws.root.name { continue }
    let m: Member := ws.member(t.name)
    // A dump is written when the root's library is compiled, so asking for one
    // compiles it.
    let dumps: bool := p.emit.len() > 0 && t.name == ws.root.name
    let after: bool := depends_on_any(ws, &m, again.as_slice())
    if dumps == false && after == false && build.fresh(ws, p, t).? { continue }
    again.push(t.name)
    out.push(t)
  }
  return .ok(out.as_slice())
}

// Whether `m` names any of `names` among what it depends on directly.
depends_on_any :: func (ws: *Workspace, m: *Member, names: []str) -> bool {
  for d in ws.direct(m) {
    for n in names {
      if d == n { return true }
    }
  }
  return false
}

// Whether any of `targets` is called `name`.
names :: func (targets: []Target, name: str) -> bool {
  for t in targets {
    if t.name == name { return true }
  }
  return false
}

// Every library but the root's own that is out of date, in order:
// what a tool that analyzes the root itself needs built.
compile_deps :: func (ws: *Workspace, p: Profile) -> Result.<void, str> {
  let libs: []Target := plan(ws, p, false).?
  compile_each(ws, p, libs, 0, libs.len()).?
  return .ok(())
}

run_metadata :: func (o: *Options) -> Result.<i32, str> {
  if o.positional.len() != 0 { return .err("`twig metadata` takes no arguments") }
  let ws: Workspace := open().?
  let mut p: Profile := build.profile(&ws.root.manifest, o.release)
  p.emit = o.emit.as_slice()
  p.nestc_args = o.nestc_args.as_slice()
  p.verbose = o.verbose
  p.build_dir = build_dir(o).?
  let text: String := metadata.describe(&ws, p).?
  io.print(text.as_str())
  io.print("\n")
  return .ok(0)
}

// `Compiling [2/5] std v0.1.0 (...)`: which of how many, so a build that takes a
// while says how far along it is.
compiling :: func (m: *Member, n: usize, total: usize) -> void {
  term.status("Compiling", f"[{n}/{total}] {m.name} v{m.manifest.package.version} ({m.dir})")
}

// A path under the package, written from the package's directory.
shown :: func (ws: *Workspace, p: str) -> str { return path.relative_to(p, ws.root.dir) }

// The binary called `name`, as a list of one.
select :: func (all: []Target, name: str) -> Result.<[]Target, str> {
  for t in all {
    if t.name == name {
      let one: Vec.<Target> := collections.vec.from_slice.<Target>(.{ t })
      return .ok(one.as_slice())
    }
  }
  return .err(f"no binary named `{name}`")
}

tests :: #when(test) namespace {
    @test
    a_package_is_compiled_again_when_something_it_depends_on_is :: func () {
        let ws: Workspace := workspace.tests.graph()
        let util: Member := ws.member("util")
        assert(depends_on_any(&ws, &util, .{ "tiny" }), "`util` depends on `tiny` directly")
        assert(depends_on_any(&ws, &util, .{ "core" }), "and on the shipped packages")
        assert(depends_on_any(&ws, &util, .{ "app" }) == false, "not on what depends on it")
        assert(depends_on_any(&ws, &util, .{}) == false)
    }

    @test
    a_target_is_found_in_a_plan_by_name :: func () {
        let libs: []Target := .{
            Target { name: "core", entry: "/w/core/src/package.nest", lib: true, test: false },
            Target { name: "util", entry: "/w/util/src/package.nest", lib: true, test: false },
        }
        assert(names(libs, "util"))
        assert(names(libs, "app") == false, "the root's library is not being compiled")
    }
}
