// Turning a workspace into `nestc` invocations, and running them.
//
// ### One function decides the command line
//
// `command` is the only place that knows which flags a build passes. Anything
// else that needs to know how a package is compiled — `twig metadata`, for an
// editor — asks it, so the answer it gives and the build that runs cannot drift
// apart. Asking whether a library is up to date is the same command with
// `--up-to-date` added.
//
// ### One run per package
//
// Every package with a `[lib]`, `core` and `std` included, is compiled once, on
// its own, into a `.nlib`, after the packages it depends on and against their
// `.nlib`s — never their source. So what a package may import is exactly what
// its command line gives it as `--extern`.
//
//     build/<profile>/deps/<name>.nlib    a dependency
//     build/<profile>/<name>.nlib         the root's own `[lib]`
//     build/<profile>/<bin>               a binary
//     build/<profile>/obj/lib/<name>/     the objects a library is made of
//     build/<profile>/obj/bin/<bin>/      the objects a binary was linked from,
//                                         its libraries' included
//
// The objects are kept, always: they are what a debugger, a profiler or a
// person reading a symbol table wants, and what a link can be run again from.
//
// A library whose inputs have not changed is not compiled again; `nestc` decides
// that, from a fingerprint in the library itself. A binary is always linked
// again.

fs :: import <std/fs>
process :: import <std/os/process>
collections :: import <std/collections>
{ Vec } :: import <std/collections>
path :: import <std/fs/path>
strs :: import <std/text/str>
{ Bin, Build, Manifest, ProfileSettings } :: import "manifest.nest"
manifest :: import "manifest.nest"
{ Workspace, Member } :: import "workspace.nest"
toolchain :: import "toolchain.nest"
term :: import "term.nest"
string :: import <std/text/string>
{ String } :: import <std/text/string>
{ OS } :: import <core/target>

// The settings one build is made with.
@public(fields: package) Profile :: struct {
  name: str,
  overflow: str,
  codegen_units: usize,
  // `0`, `1`, `2`, `3`, `s` or `z`, as `nestc -C opt-level` takes it.
  opt_level: str,
  // The compiler's dumps to write for the root package's targets, beside their
  // objects: any of `ast`, `ir`, `mono`, `lir`, `llvm-ir` and `asm`.
  emit: []str,
  // Where the build writes, when it is not the root package's own `build/`:
  // `twig --build-dir`. A build of a package that is only *depended on* — the
  // shipped `std`, whose own tests `just test` runs — would otherwise put a
  // `build/` inside a directory the build has no business writing to.
  build_dir: Option.<str>,
  // Print each compiler command before running it (`-v`). Here beside `emit`
  // because it is the same kind of thing: what this *invocation* asked for,
  // rather than what the profile says a build is.
  verbose: bool,
  // What `--nestc-arg` passed: arguments for `nestc` verbatim, last on the
  // command line, on the root package's targets only. Beside `emit` for the
  // same reason — this invocation asked for it.
  nestc_args: []str,
}

// `debug` or `release`, with whatever the root manifest changed about it.
// A dependency's `[profile]` is not read: how a program is built is the
// program's decision.
@public profile :: func (m: *Manifest, release: bool) -> Profile {
  let mut p: Profile := if release {
    Profile { name: "release", overflow: "wrap", codegen_units: 1, opt_level: "3", emit: .{}, build_dir: .none, verbose: false, nestc_args: .{} }
  } else {
    Profile { name: "debug", overflow: "trap", codegen_units: 1, opt_level: "0", emit: .{}, build_dir: .none, verbose: false, nestc_args: .{} }
  }
  let settings: Option.<ProfileSettings> := m.profile.match {
    .some(ps) => if release { ps.release } else { ps.debug },
    .none => .none,
  }
  settings.match {
    .some(s) => {
      s.overflow.match { .some(o) => { p.overflow = o }, .none => () }
      s.codegen_units.match { .some(n) => { p.codegen_units = n }, .none => () }
      s.opt_level.match { .some(l) => { p.opt_level = l }, .none => () }
    },
    .none => (),
  }
  return p
}

// What one target compiles from, and to.
@public(fields: package) Target :: struct {
  // What the output is called: the binary's name, or the package's for a
  // library.
  name: str,
  entry: str,
  lib: bool,
  // A **test binary**: the same entry as the target it is made from, compiled
  // with `nestc --test`, so that the package's `@test` functions are kept and
  // the entry point runs them instead of its `main`. It links a program even
  // when it is made from a library, because a test run is a program.
  test: bool,
}

// Every library the build makes, each after the ones it depends on: the
// dependencies', then the root's own.
@public libraries :: func (ws: *Workspace) -> []Target {
  let mut out: Vec.<Target> := collections.vec.new.<Target>()
  for d in ws.deps { out.push(library(&d)) }
  ws.root.lib_root().match {
    .some(_) => out.push(library(&ws.root)),
    .none => (),
  }
  return out.as_slice()
}

// The root package's binaries.
@public binaries :: func (ws: *Workspace) -> []Target {
  let root: *Member := &ws.root
  let mut out: Vec.<Target> := collections.vec.new.<Target>()
  for b in root.manifest.bins() {
    out.push(Target { name: b.name, entry: path.normalize(path.join(root.dir, b.path)), lib: false, test: false })
  }
  return out.as_slice()
}

library :: func (m: *Member) -> Target {
  return Target { name: m.name, entry: m.lib_root().!, lib: true, test: false }
}

// The root package's test binary: its library if it has one, and its first
// binary if it does not.
//
// One target rather than one per binary, because a package's tests are the
// package's: they sit beside the code they test, and which of several `[[bin]]`
// entries reaches a given file is not a question anyone writing a test is
// asking. A package with neither a `[lib]` nor a `[[bin]]` is already refused by
// the manifest check.
@public test_target :: func (ws: *Workspace) -> Result.<Target, str> {
  let root: *Member := &ws.root
  return root.lib_root().match {
    .some(entry) => .ok(Target { name: root.name, entry: entry, lib: true, test: true }),
    .none => {
      let bins: []Bin := root.manifest.bins()
      if bins.len() == 0 { return .err(f"`{root.name}` has no targets to test") }
      return .ok(Target {
        name: root.name,
        entry: path.normalize(path.join(root.dir, bins[0].path)),
        lib: false,
        test: true,
      })
    },
  }
}

// The root package's integration tests: one test binary per `.nest` file
// directly in its `tests/`, in name order, each named after its file.
//
// Only the files at the top: a subdirectory is where several of them share
// code, which each imports by path, and is not itself a test.
@public integration_targets :: func (ws: *Workspace) -> Result.<[]Target, str> {
  let root: *Member := &ws.root
  let dir: str := path.join(root.dir, "tests")
  let mut out: Vec.<Target> := collections.vec.new.<Target>()
  if fs.exists(dir) == false { return .ok(out.as_slice()) }
  let names: []str := fs.read_dir(dir).match {
    .ok(ns) => ns,
    .err(e) => { return .err(e.describe()) },
  }
  for name in names {
    if strs.ends_with(name, ".nest") == false { continue }
    const stem: str := strs.slice(name, 0, name.len() - 5)
    out.push(Target {
      name: f"{root.name}-{stem}",
      entry: path.normalize(path.join(dir, name)),
      lib: false,
      test: true,
    })
  }
  return .ok(out.as_slice())
}

// Where a build with `p` writes: the root package's `build/`, or what
// `--build-dir` named instead.
//
// Everything a build produces is under this one directory — every dependency's
// `.nlib` and every object included — so a package that is merely depended on
// is never written to. `--build-dir` is for the case where even the *root*
// package's directory should be left alone: `std` ships with the compiler and
// its own tests are still built from its sources.
@public out_dir :: func (ws: *Workspace, p: Profile) -> str {
  let base: str := p.build_dir.match {
    .some(d) => d,
    .none => path.join(ws.root.dir, "build"),
  }
  return path.join(base, p.name)
}

// The file `t` produces.
@public output :: func (ws: *Workspace, p: Profile, t: Target) -> str {
  if t.test { return path.join(out_dir(ws, p), f"{t.name}-test{EXE}") }
  if t.lib { return library_file(ws, p, t.name) }
  return path.join(out_dir(ws, p), f"{t.name}{EXE}")
}

// What an executable's file name ends in on the host, which is the target:
// Windows finds a program by its `.exe`, and nothing else wants a suffix.
EXE: str :: OS.match {
  .Windows => ".exe",
  _        => "",
}

// The dumps `--emit` accepts, for a message.
@public EMITS: str :: "ast, ir, mono, lir, llvm-ir, asm"

// Whether `--emit` accepts `e`.
@public known_emit :: func (e: str) -> bool {
  return e == "ast" || e == "ir" || e == "mono" || e == "lir" || e == "llvm-ir" || e == "asm"
}

// What `nestc --emit` calls the dump twig calls `e`.
emit_kind :: func (e: str) -> str {
  if e == "llvm-ir" { return "backend-ir" }
  return e
}

// The file extension of the dump `e`.
extension :: func (e: str) -> str {
  if e == "llvm-ir" { return "ll" }
  if e == "asm" { return "s" }
  return e
}

// Where the objects `t` is made from are kept: apart for a library and a binary,
// which may share a name.
@public objects :: func (ws: *Workspace, p: Profile, t: Target) -> str {
  let kind: str := if t.test { "test" } else if t.lib { "lib" } else { "bin" }
  return path.join(path.join(path.join(out_dir(ws, p), "obj"), kind), t.name)
}

// The `.nlib` of the package called `name`.
library_file :: func (ws: *Workspace, p: Profile, name: str) -> str {
  let dir: str := out_dir(ws, p)
  if name == ws.root.name { return path.join(dir, f"{name}.nlib") }
  return path.join(path.join(dir, "deps"), f"{name}.nlib")
}

@public(fields: package) Command :: struct {
  program: str,
  args: []str,
}

// The `nestc` run that builds `t`.
@public command :: func (ws: *Workspace, p: Profile, t: Target) -> Command {
  let mut args: Vec.<str> := collections.vec.new.<str>()
  args.push(t.entry)
  if t.lib {
    args.push("--package")
    args.push(f"{t.name}={t.entry}")
  }
  if t.test { args.push("--test") }
  args.push("--emit")
  // A test target links a program whatever it was made from: what it produces is
  // something to run, not something to depend on.
  let mut emit: str := if t.lib && t.test == false { "nlib" } else { "link" }
  if own(ws, t) {
    for e in p.emit {
      let file: str := path.join(objects(ws, p, t), f"{t.name}.{extension(e)}")
      emit = f"{emit},{emit_kind(e)}={file}"
    }
  }
  args.push(emit)
  args.push("-o")
  args.push(output(ws, p, t))
  args.push("--obj-dir")
  args.push(objects(ws, p, t))

  // A library may import what its package depends on. A binary may import
  // that too, and the root's own library as well, by name.
  let mut direct: Vec.<str> := collections.vec.new.<str>()
  if t.lib == false {
    ws.root.lib_root().match {
      .some(_) => direct.push(ws.root.name),
      .none => (),
    }
  }
  let m: Member := if t.lib { ws.member(t.name) } else { ws.root }
  direct.extend(ws.direct(&m))
  for d in direct.as_slice() { library_flag(&mut args, ws, p, "--extern", d) }
  for d in ws.indirect(direct.as_slice()) { library_flag(&mut args, ws, p, "--indirect", d) }

  setting(&mut args, f"profile={p.name}")
  setting(&mut args, f"overflow={p.overflow}")
  setting(&mut args, f"codegen-units={p.codegen_units}")
  setting(&mut args, f"opt-level={p.opt_level}")

  // What the root package asked to add to its own command, last, so that it
  // beats what twig decided: the manifest's `[build]` and then this run's
  // `--nestc-arg`, which is the more specific of the two.
  if own(ws, t) {
    extra(&mut args, ws, p)
  }
  return Command { program: toolchain.nestc(), args: args.as_slice() }
}

// Whether `t` is a target of the **root** package: one of its binaries, or its
// own library. A dependency is compiled the way its own package says, and
// nothing a build of this package passes reaches it.
own :: func (ws: *Workspace, t: Target) -> bool {
  return t.lib == false || t.name == ws.root.name
}

// The root package's own additions to a command: its `[build]` section, and
// then whatever `--nestc-arg` passed.
extra :: func (args: *mut Vec.<str>, ws: *Workspace, p: Profile) -> void {
  let b: Build := ws.root.manifest.build_section()
  b.linker.match {
    .some(l) => setting(args, f"linker={l}"),
    .none => (),
  }
  for a in manifest.strings(b.link_args) { setting(args, f"link-arg={a}") }
  for l in manifest.strings(b.link_libs) {
    args.push("-l")
    args.push(l)
  }
  for d in manifest.strings(b.link_search) {
    args.push("--link-search")
    args.push(path.normalize(path.join(ws.root.dir, d)))
  }
  for a in manifest.strings(b.nestc_args) { args.push(a) }
  for a in p.nestc_args { args.push(a) }
}

library_flag :: func (args: *mut Vec.<str>, ws: *Workspace, p: Profile, flag: str, name: str) -> void {
  args.push(flag)
  args.push(f"{name}={library_file(ws, p, name)}")
}

setting :: func (args: *mut Vec.<str>, value: str) -> void {
  args.push("-C")
  args.push(value)
}

// Whether the library `t` is up to date, so that compiling it would produce what
// is already there.
@public fresh :: func (ws: *Workspace, p: Profile, t: Target) -> Result.<bool, str> {
  let c: Command := command(ws, p, t)
  let mut args: Vec.<str> := collections.vec.from_slice.<str>(c.args)
  args.push("--up-to-date")
  if p.verbose { trace(c.program, args.as_slice()) }
  let status: process.Status := run(c.program, args.as_slice()).?
  return status.match {
    .exited(0) => .ok(true),
    .exited(1) => .ok(false),
    // What a child that could not `exec` exits with (`process.spawn`).
    .exited(127) => .err(toolchain.not_found(c.program)),
    _ => .err(f"could not tell whether `{t.name}` is up to date"),
  }
}

// Build `t`, with the compiler's diagnostics going straight to this process's
// stderr.
@public compile :: func (ws: *Workspace, p: Profile, t: Target) -> Result.<void, str> {
  fs.create_dir_all(path.parent(output(ws, p, t))).match {
    .ok(_) => (),
    .err(e) => { return .err(e.describe()) },
  }
  let c: Command := command(ws, p, t)
  if p.verbose { trace(c.program, c.args) }
  let status: process.Status := run(c.program, c.args).?
  return status.match {
    .exited(0) => .ok(()),
    .exited(127) => .err(toolchain.not_found(c.program)),
    _ => .err(f"could not compile `{t.name}`"),
  }
}

// One compiler command, as it is about to be run.
//
// Every argument is quoted whether or not it needs to be, so that the line can
// be pasted back into a shell without the reader checking which ones contained
// a space. That is the whole point of printing it: a build that went wrong is
// then one paste away from being run by hand.
trace :: func (program: str, args: []str) -> void {
  let mut line: String := string.from(quoted(program))
  for a in args {
    line.push_str(" ")
    line.push_str(quoted(a))
  }
  term.status("Running", line.as_str())
}

// A shell-safe spelling of one argument: single quotes, with any single quote
// inside ended, escaped, and reopened — `it's` becomes `'it'\''s'`.
quoted :: func (a: str) -> str {
  let mut out: String := string.from("'")
  for b in a.as_bytes() {
    if b == 39 { out.push_str("'\\''") } else { out.push_byte(b) }
  }
  out.push_str("'")
  return out.as_str()
}

run :: func (program: str, args: []str) -> Result.<process.Status, str> {
  return process.run(program, args).match {
    .ok(s) => .ok(s),
    .err(e) => .err(f"could not run `{program}`: {e.describe()}"),
  }
}

// The tests, in a namespace of their own (spec §9.2). They cover the part of
// this file that is a *translation* — twig's vocabulary into `nestc`'s — which
// is where a silent mistake produces a build that runs and writes the wrong
// thing rather than one that fails.
tests :: #when(test) namespace {
    // A package: a name, whether it has a `[lib]`, and what it depends on.
    member :: func (name: str, lib: bool, deps: []str, build: Option.<Build>) -> Member {
        let mut d: collections.HashMap.<str, manifest.Dependency> :=
            collections.hash_map.new.<str, manifest.Dependency>()
        for n in deps { d.insert(n, manifest.Dependency { path: .some(f"../{n}") }) }
        let l: Option.<manifest.Lib> := if lib {
            .some(manifest.Lib { path: "src/package.nest" })
        } else {
            .none
        }
        let b: Option.<[]Bin> := if lib {
            .none
        } else {
            .some(.{ Bin { name: name, path: "src/main.nest" } })
        }
        return Member {
            name: name,
            dir: f"/w/{name}",
            manifest: Manifest {
                package: manifest.Package { name: name, version: "0.1.0" },
                lib: l,
                bin: b,
                dependencies: .some(d),
                profile: .none,
                build: build,
            },
        }
    }

    // `app` (a binary, depending on `util`), `util` (a library, depending on
    // `tiny`), `tiny`, and the two packages that ship with the compiler.
    workspace :: func (build: Option.<Build>) -> Workspace {
        return Workspace {
            root: member("app", false, .{ "util" }, build),
            deps: .{
                member("core", true, .{}, .none),
                member("std", true, .{}, .none),
                member("tiny", true, .{}, .none),
                member("util", true, .{ "tiny" }, .none),
            },
            shipped: .{ "core", "std" },
        }
    }

    profile :: func () -> Profile {
        return Profile {
            name: "debug",
            overflow: "trap",
            codegen_units: 1,
            opt_level: "0",
            emit: .{},
            build_dir: .none,
            verbose: false,
            nestc_args: .{},
        }
    }

    // Whether `args` has `a` immediately followed by `b`, which is how every
    // flag that takes a value is pushed.
    pair :: func (args: []str, a: str, b: str) -> bool {
        for i in 0..<args.len() {
            if args[i] == a && i + 1 < args.len() && args[i + 1] == b { return true }
        }
        return false
    }

    has :: func (args: []str, a: str) -> bool {
        for x in args {
            if x == a { return true }
        }
        return false
    }

    binary :: func (ws: *Workspace) -> Target {
        return Target { name: "app", entry: "/w/app/src/main.nest", lib: false, test: false }
    }

    library :: func (ws: *Workspace, name: str) -> Target {
        return Target { name: name, entry: f"/w/{name}/src/package.nest", lib: true, test: false }
    }

    // What a package may import is exactly what its command line gives it as
    // `--extern`; what its dependencies need in order to link is `--indirect`.
    @test
    externs_are_direct_and_the_rest_is_indirect :: func () {
        let ws: Workspace := workspace(.none)
        let p: Profile := profile()
        let app: []str := command(&ws, p, binary(&ws)).args
        assert(pair(app, "--extern", f"util={library_file(&ws, p, "util")}"))
        assert(pair(app, "--extern", f"core={library_file(&ws, p, "core")}"))
        assert(pair(app, "--indirect", f"tiny={library_file(&ws, p, "tiny")}"),
               "`tiny` is a dependency of a dependency: linked, not importable")

        // `util` sees its own dependency and the shipped packages, and nothing
        // of the package being built.
        let util: []str := command(&ws, p, library(&ws, "util")).args
        assert(pair(util, "--extern", f"tiny={library_file(&ws, p, "tiny")}"))
        assert(has(util, f"app={library_file(&ws, p, "app")}") == false)
    }

    // A library is a `.nlib` to compile against; a binary is a program.
    @test
    a_library_emits_an_nlib_and_a_binary_links :: func () {
        let ws: Workspace := workspace(.none)
        let p: Profile := profile()
        let util: []str := command(&ws, p, library(&ws, "util")).args
        assert(pair(util, "--emit", "nlib"))
        assert(pair(util, "--package", "util=/w/util/src/package.nest"))
        assert(pair(util, "-o", library_file(&ws, p, "util")))

        let app: []str := command(&ws, p, binary(&ws)).args
        assert(pair(app, "--emit", "link"))
        assert(has(app, "--package") == false, "only a library is named as a package")
        assert(pair(app, "-o", output(&ws, p, binary(&ws))))
    }

    // `[build]` and `--nestc-arg` are the **root** package's, and reach only the
    // targets it is made of: a dependency is compiled the way its own package
    // says.
    @test
    the_root_s_flags_do_not_reach_a_dependency :: func () {
        let b: Build := Build {
            linker: .some("clang"),
            link_args: .some(.{ "-Wl,-dead_strip" }),
            link_libs: .some(.{ "sfml-graphics" }),
            link_search: .some(.{ "vendor/lib" }),
            nestc_args: .some(.{ "-C", "opt-level=2" }),
        }
        let ws: Workspace := workspace(.some(b))
        let mut p: Profile := profile()
        p.nestc_args = .{ "-C", "overflow=wrap" }

        let app: []str := command(&ws, p, binary(&ws)).args
        assert(pair(app, "-C", "linker=clang"))
        assert(pair(app, "-C", "link-arg=-Wl,-dead_strip"))
        assert(pair(app, "-l", "sfml-graphics"))
        // A relative search path is the package's, not the one the build was
        // started from.
        assert(pair(app, "--link-search", "/w/app/vendor/lib"))
        // The manifest's, and then this run's, so that `--nestc-arg` wins.
        assert(pair(app, "-C", "opt-level=2"))
        assert(app[app.len() - 1] == "overflow=wrap")

        let util: []str := command(&ws, p, library(&ws, "util")).args
        assert(has(util, "-l") == false)
        assert(has(util, "linker=clang") == false)
        assert(has(util, "overflow=wrap") == false)
        // What the profile decided still reaches it.
        assert(pair(util, "-C", "overflow=trap"))
    }

    // `--build-dir` moves **everything** a build writes, a dependency's
    // `.nlib` and the objects included. What it is for is a root package whose
    // directory is not the build's to write in — `std` ships with the compiler,
    // and `just test` builds its tests from its sources.
    @test
    a_build_dir_moves_everything_the_build_writes :: func () {
        let ws: Workspace := workspace(.none)
        let mut p: Profile := profile()
        p.build_dir = .some("/out")
        assert(out_dir(&ws, p) == "/out/debug")
        assert(output(&ws, p, binary(&ws)) == f"/out/debug/app{EXE}")
        assert(library_file(&ws, p, "util") == "/out/debug/deps/util.nlib")
        assert(objects(&ws, p, binary(&ws)) == "/out/debug/obj/bin/app")
        // Including what the command line says the dependency is read from.
        let app: []str := command(&ws, p, binary(&ws)).args
        assert(pair(app, "--extern", "util=/out/debug/deps/util.nlib"))

        // With nothing said, the root package's own `build/`, as before.
        let d: Profile := profile()
        assert(out_dir(&ws, d) == "/w/app/build/debug")
    }

    @test
    dump_names :: func () {
        assert(known_emit("lir"))
        assert(known_emit("llvm-ir"))
        assert(known_emit("obj") == false, "`obj` is an output, not a dump")
        // What twig calls a dump is not always what `nestc` calls it.
        assert(emit_kind("llvm-ir") == "backend-ir")
        assert(emit_kind("lir") == "lir")
        assert(extension("llvm-ir") == "ll")
        assert(extension("asm") == "s")
        assert(extension("mono") == "mono")
    }
}
