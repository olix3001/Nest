// math.nest — a tiny library of integer helpers, imported by use_math.nest.
// Every exported item is marked @public; private helpers stay hidden.

@public
add :: func (a: isize, b: isize) -> isize {
  return a + b
}

@public
square :: func (n: isize) -> isize {
  return n * n
}

@public
factorial :: func (n: isize) -> isize {
  let acc := 1
  let i := 2
  while i <= n {
    acc = acc * i
    i += 1
  }
  return acc
}

// Private to this file: not visible to importers.
clamp_low :: func (n: isize, low: isize) -> isize {
  if n < low {
    return low
  }
  return n
}
