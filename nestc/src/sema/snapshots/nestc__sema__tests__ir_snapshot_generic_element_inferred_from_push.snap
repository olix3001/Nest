func build_ints() -> usize {
  let xs: Vector.<isize> = (Vector.new: func() -> Vector.<isize>)(): Vector.<isize>
  ((xs: Vector.<isize>.push): func(*mut Vector.<isize>, isize) -> void)(1: isize): void
  return (xs: Vector.<isize>.len): usize
}
func build_strings() -> void {
  let ws: Vector.<string> = (Vector.new: func() -> Vector.<string>)(): Vector.<string>
  tail ((ws: Vector.<string>.push): func(*mut Vector.<string>, string) -> void)("hi": string): void
}
func new() -> Vector.<T> {
  return Vector { len: 0: usize }: Vector.<T>
}
func push(self: *mut Vector.<T>, value: T) -> void {
  ((self: *mut Vector.<T>.*): Vector.<T>.len): usize = #builtin(Add) (core.Add.add: func(usize, usize) -> usize)(((self: *mut Vector.<T>.*): Vector.<T>.len): usize, 1: usize): usize
}
