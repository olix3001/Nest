struct Vector {
  len: usize
}
func build_ints() -> usize {
  let xs: Vector.<isize> = (Vector.new: *func() -> Vector.<isize>)(): Vector.<isize>
  (Vector.push: *func(*mut Vector.<isize>, isize) -> void)((&mut xs: Vector.<isize>): *mut Vector.<isize>, $cast(1: comptime_int): isize): void
  return (xs: Vector.<isize>.len): usize
}
func build_strings() -> void {
  let ws: Vector.<core.types.str.str> = (Vector.new: *func() -> Vector.<core.types.str.str>)(): Vector.<core.types.str.str>
  tail (Vector.push: *func(*mut Vector.<core.types.str.str>, core.types.str.str) -> void)((&mut ws: Vector.<core.types.str.str>): *mut Vector.<core.types.str.str>, $cast("hi": comptime_str): core.types.str.str): void
}
func new() -> Vector.<T> {
  return Vector { len: $cast(0: comptime_int): usize }: Vector.<T>
}
func push(self: *mut Vector.<T>, value: T) -> void #self(*mut) #mutating {
  ((self: *mut Vector.<T>.*): Vector.<T>.len): usize = #builtin(Add) (core.ops.Add.add: *func(usize, usize) -> usize)(((self: *mut Vector.<T>.*): Vector.<T>.len): usize, $cast(1: comptime_int): usize): usize
}
