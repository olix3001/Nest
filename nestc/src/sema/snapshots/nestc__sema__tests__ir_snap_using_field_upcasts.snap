struct Transform {
  x: i32
  y: i32
}
struct Entity {
  t: Transform
  hp: i32
}
func take(t: Transform) -> i32 {
  return (t: Transform.x): i32
}
func nudge(t: *mut Transform) -> void #mutating {
}
func up(e: Entity, p: *mut Entity) -> i32 #mutating {
  (nudge: func(*mut Transform) -> void)((&mut ((p: *mut Entity.*): Entity.t): Transform): *mut Transform): void
  let m: i32 = (Transform.mag: func(Transform) -> i32)((e: Entity.t): Transform): i32
  return (take: func(Transform) -> i32)((e: Entity.t): Transform): i32
}
func mag(self: Transform) -> i32 #recv(value) {
  return (self: Transform.x): i32
}
