func bits(a: i32, b: i32) -> i32 {
  let an: i32 = #builtin(BitAnd) (core.BitAnd.bitand: func(i32, i32) -> i32)(a: i32, b: i32): i32
  let orr: i32 = #builtin(BitOr) (core.BitOr.bitor: func(i32, i32) -> i32)(a: i32, b: i32): i32
  let xr: i32 = #builtin(BitXor) (core.BitXor.bitxor: func(i32, i32) -> i32)(a: i32, b: i32): i32
  let sl: i32 = #builtin(Shl) (core.Shl.shl: func(i32, i32) -> i32)(a: i32, b: i32): i32
  let sr: i32 = #builtin(Shr) (core.Shr.shr: func(i32, i32) -> i32)(a: i32, b: i32): i32
  return an: i32
}
