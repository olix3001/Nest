source: src/sema/tests.rs
expression: "ir_text(\"rd :: func (p: *i32, q: *mut i32) -> i32 {\\n  let v := 0\\n  let r := &p\\n  let w := &mut v\\n  q.* = 1\\n  return p.*\\n}\\n\")"
---
func rd(p: *i32, q: *mut i32) -> i32 #mutating {
  let v: isize = $cast(0: comptime_int): isize
  let r: **i32 = (&p: *i32): **i32
  let w: *mut isize = (&mut v: isize): *mut isize
  (q: *mut i32.*): i32 = $cast(1: comptime_int): i32
  return (p: *i32.*): i32
}
