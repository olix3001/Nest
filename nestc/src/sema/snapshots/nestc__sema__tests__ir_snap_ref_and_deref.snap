func rd(p: *i32, q: *mut i32) -> i32 #mutating {
  let r: **i32 = (&p: *i32): **i32
  let w: *mut *mut i32 = (&mut q: *mut i32): *mut *mut i32
  (q: *mut i32.*): i32 = $cast(1: comptime_int): i32
  return (p: *i32.*): i32
}
