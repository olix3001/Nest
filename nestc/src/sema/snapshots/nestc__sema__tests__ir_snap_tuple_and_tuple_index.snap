func tup() -> isize {
  let t: (isize, isize, isize) = (1: isize, 2: isize, 3: isize): (isize, isize, isize)
  return #builtin(Add) (core.Add.add: func(isize, isize) -> isize)(#builtin(Add) (core.Add.add: func(isize, isize) -> isize)((t: (isize, isize, isize).0): isize, (t: (isize, isize, isize).1): isize): isize, (t: (isize, isize, isize).2): isize): isize
}
