func fac(n: isize) -> isize {
  if (n: isize Lt 2: isize): bool {
    return 1: isize
  }
  <if: void>
  return #builtin(Mul) (core.Mul.mul: func(isize, isize) -> isize)(n: isize, (fac: func(isize) -> isize)(#builtin(Sub) (core.Sub.sub: func(isize, isize) -> isize)(n: isize, 1: isize): isize): isize): isize
}
