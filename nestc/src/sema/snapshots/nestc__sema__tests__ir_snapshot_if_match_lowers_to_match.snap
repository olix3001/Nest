func choose(o: core.Option.<i32>) -> i32 {
  match o: core.Option.<i32> {
    block: void {
      return v: i32
    }
    .some(v) => <block: void>
    block: void {
      return $cast(0: comptime_int): i32
    }
    _ => <block: void>
  }
  tail <match: never>
}
