expression: "ir_text(\"mo :: func (o: Option.<i32>) -> i32 {\\n  return o.match {\\n    .some(v) => v,\\n    .none => 0,\\n  }\\n}\\n\")"
---
func mo(o: core.types.option.Option.<i32>) -> i32 {
  match o: core.types.option.Option.<i32> {
    .some(v) => v: i32
    .none => $cast(0: comptime_int): i32
  }
  return <match: i32>
}
