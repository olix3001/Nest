func arith(a: i32, b: i32) -> i32 {
  let s: i32 = #builtin(Add) (core.Add.add: func(i32, i32) -> i32)(a: i32, b: i32): i32
  let d: i32 = #builtin(Sub) (core.Sub.sub: func(i32, i32) -> i32)(a: i32, b: i32): i32
  let m: i32 = #builtin(Mul) (core.Mul.mul: func(i32, i32) -> i32)(a: i32, b: i32): i32
  let q: i32 = #builtin(Div) (core.Div.div: func(i32, i32) -> i32)(a: i32, b: i32): i32
  let r: i32 = #builtin(Rem) (core.Rem.rem: func(i32, i32) -> i32)(a: i32, b: i32): i32
  return s: i32
}
