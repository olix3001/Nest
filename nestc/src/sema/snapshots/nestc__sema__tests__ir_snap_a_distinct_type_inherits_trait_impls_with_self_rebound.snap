distinct Meters = f64
trait Show {
  [0] show: func(Show) -> usize #self
}
struct Base {
  n: usize
}
distinct Inherits = Base
distinct Overrides = Base
func f(a: Meters, b: Meters) -> Meters {
  return #builtin(Add) (core.Add.add: func(Meters, Meters) -> Meters)(a: Meters, b: Meters): Meters
}
func g(a: Inherits, b: Overrides) -> usize {
  return #builtin(Add) (core.Add.add: func(usize, usize) -> usize)((Base.show: func(Base) -> usize)($cast(a: Inherits): Base): usize, (<impl Overrides>.show: func(Overrides) -> usize)(b: Overrides): usize): usize
}
func show(self: Base) -> usize #self {
  return $cast(1: comptime_int): usize
}
func show(self: Overrides) -> usize #self {
  return $cast(2: comptime_int): usize
}
