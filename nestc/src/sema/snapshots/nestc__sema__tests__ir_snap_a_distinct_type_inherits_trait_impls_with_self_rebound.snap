func g(a: Inherits, b: Overrides) -> usize {
  return #builtin(Add) (core.Add.add: func(usize, usize) -> usize)((Base.show: func(Base) -> usize)($cast(a: Inherits): Base): usize, (<impl Overrides>.show: func(Overrides) -> usize)(b: Overrides): usize): usize
