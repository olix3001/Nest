---
source: src/sema/tests.rs
expression: "ir_text(\"ml :: func (n: i32) -> i32 {\\n  return n.match {\\n    0 => 10,\\n    1 | 2 => 20,\\n    x if x > 5 => 30,\\n    _ => 0,\\n  }\\n}\\n\")"
---
func ml(n: i32) -> i32 {
  match n: i32 {
    0 => $cast(10: comptime_int): i32
    1 | 2 => $cast(20: comptime_int): i32
    x => if (x: i32 Gt $cast(5: comptime_int): i32): bool $cast(30: comptime_int): i32
    _ => $cast(0: comptime_int): i32
  }
  return <match: i32>
}
