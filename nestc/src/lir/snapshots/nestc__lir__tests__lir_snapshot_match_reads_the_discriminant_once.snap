unit mem:main {
  type Shape = struct {           // was a enum; size 12, align 4
    tag: u8                    // +0
    payload: [8]u8                    // +4
  }
    // tag 0 => .dot as Shape.dot
    // tag 1 => .circle as Shape.circle(0: i32 +0)
    // tag 2 => .rect as Shape.rect { w: i32 +0, h: i32 +4 }
  type Shape.dot = struct {           // was a variant of Shape; size 0, align 1
  }
  type Shape.circle = struct {           // was a variant of Shape; size 4, align 4
    0: i32                    // +0
  }
  type Shape.rect = struct {           // was a variant of Shape; size 8, align 4
    w: i32                    // +0
    h: i32                    // +4
  }

  func area(s_0: Shape) -> i32  // _NC4area
    let _1: i32
    let _2: u8
    let r_3: i32
    let w_4: i32
    let h_5: i32
  bb0:                    // entry
    _2 := s_0.tag
    switch.u8 _2 { 0 => bb7, 1 => bb8, 2 => bb9, _ => bb5 }
  bb1:                    // join
    return _1
  bb2:                    // arm .dot
    _1 := 0
    goto bb1
  bb3:                    // arm .circle
    _1 := r_3
    goto bb1
  bb4:                    // arm .rect
    _1 := w_4
    goto bb1
  bb5:                    // no variant matched
    unreachable
  bb6:                    // unreachable
    unreachable
  bb7:                    // .dot
    goto bb2
  bb8:                    // .circle
    r_3 := (s_0.payload as Shape.circle).0
    goto bb3
  bb9:                    // .rect
    w_4 := (s_0.payload as Shape.rect).w
    h_5 := (s_0.payload as Shape.rect).h
    goto bb4
}
