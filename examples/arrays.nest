// arrays.nest — fixed-length arrays, `const` generic values, and `.len`.
// No imports.

// The length of a `[N]T` is part of its type, so these are different types and
// neither converts to the other.
@public
THREE :: 3

@public
triple :: func () -> [THREE]i32 {
  return [_]i32 { 1, 2, 3 }
}

// `<const N: usize>` is a compile-time *value* parameter. `N` names a length in
// the signature and a `usize` in the body; the call site solves it from the
// argument's type, so `sum(triple())` instantiates this at `N = 3`.
@public
sum :: func <const N: usize, T> (xs: [N]T) -> usize {
  return N
}

// `.len` is sugar for the `$len` intrinsic. On a fixed array whose length is
// known it folds to a constant; on a slice it reads the header at run time.
@public
lengths :: func (s: []i32) -> usize {
  const fixed := triple()
  return fixed.len + $len(s)
}

// A fixed array coerces to a read-only slice, which is how one function serves
// both shapes.
@public
count_slice :: func (s: []i32) -> usize {
  return s.len
}

@public
main :: func () {
  const a := triple()
  const n := sum(a)
  const m := count_slice(a)
  const k := lengths(a)
}
