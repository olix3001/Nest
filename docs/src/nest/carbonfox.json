{
  "$comment": "Carbonfox (EdenEast/nightfox.nvim) as a TextMate theme. Colors are nightfox's carbonfox palette, and each scope takes the color nightfox gives the matching tree-sitter capture — so Nest reads here as it does in Neovim/Zed with editors/tree-sitter-nest.",
  "name": "carbonfox",
  "type": "dark",
  "colors": {
    "editor.background": "#161616",
    "editor.foreground": "#f2f4f8",
    "editor.selectionBackground": "#2a2a2a",
    "editor.lineHighlightBackground": "#252525",
    "editorLineNumber.foreground": "#7b7c7e",
    "editorGroupHeader.tabsBackground": "#0c0c0c",
    "tab.activeBackground": "#161616",
    "tab.activeForeground": "#f2f4f8",
    "tab.inactiveBackground": "#0c0c0c",
    "tab.inactiveForeground": "#7b7c7e",
    "tab.border": "#353535",
    "tab.activeBorderTop": "#08bdba",
    "focusBorder": "#353535"
  },
  "tokenColors": [
    { "scope": ["source", "text"], "settings": { "foreground": "#f2f4f8" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#dfdfe0" } },
    { "scope": ["variable.language", "variable.other.capture"], "settings": { "foreground": "#ee5396" } },
    { "scope": "variable.parameter", "settings": { "foreground": "#52bdff" } },
    { "scope": ["variable.other.member", "variable.other.property", "meta.field"], "settings": { "foreground": "#78a9ff" } },
    { "scope": "comment", "settings": { "foreground": "#6e6f70" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#25be6a" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#2dc7c4", "fontStyle": "bold" } },
    { "scope": ["string.other.package-path", "keyword.other.format-spec"], "settings": { "foreground": "#8cb6ff" } },
    { "scope": ["constant.numeric", "constant.language.boolean"], "settings": { "foreground": "#3ddbd9" } },
    { "scope": ["constant", "variable.other.constant"], "settings": { "foreground": "#5ae0df" } },
    { "scope": "constant.language", "settings": { "foreground": "#5ae0df" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#be95ff" } },
    { "scope": ["keyword.control.conditional", "keyword.control.repeat"], "settings": { "foreground": "#c8a5ff" } },
    { "scope": "keyword.control.return", "settings": { "foreground": "#ee5396" } },
    { "scope": ["keyword.control.import", "keyword.other.directive", "keyword.control.when"], "settings": { "foreground": "#ff91c1" } },
    { "scope": ["keyword.operator", "keyword.operator.word"], "settings": { "foreground": "#b6b8bb" } },
    { "scope": "punctuation", "settings": { "foreground": "#b6b8bb" } },
    { "scope": "punctuation.section.interpolation", "settings": { "foreground": "#52bdff" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#8cb6ff" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#08bdba" } },
    { "scope": ["support.type", "support.type.builtin"], "settings": { "foreground": "#52bdff" } },
    { "scope": "entity.name.namespace", "settings": { "foreground": "#52bdff" } },
    { "scope": "entity.name.constructor", "settings": { "foreground": "#33b1ff" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#5ae0df" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#8cb6ff" } },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.inserted", "settings": { "foreground": "#25be6a" } },
    { "scope": "markup.deleted", "settings": { "foreground": "#ee5396" } },
    { "scope": "markup.changed", "settings": { "foreground": "#08bdba" } },
    { "scope": ["support.type.property-name", "entity.name.tag"], "settings": { "foreground": "#78a9ff" } }
  ]
}
